// ==============================================================================
// 1. CARTERA DE PRÉSTAMOS Y RIESGO CREDITICIO (P1, P2, P6, D1)
// ==============================================================================

// Cartera total colocada ($103,261,740.00)
Cartera Total = SUM(Fact_Prestamos[monto_prestamo])

// Cantidad total de préstamos (682)
Num Prestamos = COUNTROWS(Fact_Prestamos)

// Préstamos en mora activa irremediable (Estado D: 45 créditos)
Prestamos en Mora = CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = "D")

// Préstamos vigentes en ejecución (Estados C + D: 448 créditos)
Prestamos Vigentes = CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {"C", "D"})

// Préstamos cerrados con quebranto definitivo (Estado B: 31 créditos)
Prestamos Incumplidos = CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = "B")

// Préstamos cerrados históricos (Estados A + B: 234 créditos)
Prestamos Cerrados = CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {"A", "B"})

// Tasa de Morosidad Activa sobre Cartera Vigente (10.0446%)
Tasa Mora Vigente = DIVIDE([Prestamos en Mora], [Prestamos Vigentes], 0)

// Tasa de Incumplimiento sobre Cartera Cerrada (13.2478%)
Tasa Incumplimiento = DIVIDE([Prestamos Incumplidos], [Prestamos Cerrados], 0)

// Cartera en riesgo colocada (B + D: $15,578,460.00)
Monto en Riesgo = CALCULATE(SUM(Fact_Prestamos[monto_prestamo]), Dim_Estado_Prestamo[codigo_estado] IN {"B", "D"})

// Monto promedio por préstamo ($151,410.18)
Monto Promedio Prestamo = AVERAGE(Fact_Prestamos[monto_prestamo])

// Desviación estándar del préstamo ($74,180.42)
Desv Est Prestamo = STDEV.S(Fact_Prestamos[monto_prestamo])

// Límites de control (+- 1 sigma)
Prestamo Limite Superior = [Monto Promedio Prestamo] + [Desv Est Prestamo]
Prestamo Limite Inferior = [Monto Promedio Prestamo] - [Desv Est Prestamo]


// ==============================================================================
// 2. CAPTACIÓN, DEPÓSITOS Y RATIO DE ABSORCIÓN (P3, D1)
// ==============================================================================

// Saldo final en depósitos al corte del 31/12/1998 ($197,140,434.00)
// Utiliza la vista semiaditiva vw_PBI_Saldo_Final_Cuenta
Saldo Depositos = SUM(vw_PBI_Saldo_Final_Cuenta[saldo_final])

// Ratio de Absorción Crediticia (52.3803%)
// Cartera colocada total / Depósitos captados al corte
Ratio Absorcion = 
    DIVIDE(
        CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo)),
        [Saldo Depositos],
        0
    )

// Cobertura de Liquidez Libre ($93,878,694.00)
Liquidez Libre = [Saldo Depositos] - CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo))


// ==============================================================================
// 3. FLUJO TRANSACCIONAL Y VOLATILIDAD OPERATIVA (P4, D2)
// ==============================================================================

// Volumen transaccionado acumulado ($6,257,862,197.00)
Volumen Transaccionado = SUM(vw_PBI_Trans_Anual_Cuenta[monto_total])

// Cantidad de transacciones (1,056,320)
Num Transacciones = SUM(vw_PBI_Trans_Anual_Cuenta[num_transacciones])

// Ticket promedio de transacción ($5,924.21)
Ticket Promedio Transaccion = DIVIDE([Volumen Transaccionado], [Num Transacciones], 0)

// Desviación estándar muestral exacta calculada desde la agregación con suma de cuadrados
Desv Est Transaccion = 
    VAR n = [Num Transacciones]
    VAR s = [Volumen Transaccionado]
    VAR sq = SUM(vw_PBI_Trans_Anual_Cuenta[suma_cuadrados])
    RETURN 
        IF(n > 1, SQRT(DIVIDE(sq - (s * s / n), n - 1)), 0)

Transaccion Limite Superior = [Ticket Promedio Transaccion] + [Desv Est Transaccion]
Transaccion Limite Inferior = [Ticket Promedio Transaccion] - [Desv Est Transaccion]

// Saldo promedio histórico ponderado de las cuentas
Saldo Promedio Historico = 
    DIVIDE(
        SUMX(vw_PBI_Trans_Anual_Cuenta, vw_PBI_Trans_Anual_Cuenta[saldo_promedio] * vw_PBI_Trans_Anual_Cuenta[num_transacciones]),
        [Num Transacciones],
        0
    )


// ==============================================================================
// 4. ÓRDENES PERMANENTES Y SATURACIÓN FINANCIERA (P5, D2)
// ==============================================================================

// Compromiso mensual de pagos automáticos ($21,229,041.00)
Compromiso Ordenes = SUM(Fact_Ordenes[monto_orden])

// Cantidad de órdenes permanentes (6,471)
Num Ordenes = COUNTROWS(Fact_Ordenes)

// Índice de Saturación Financiera = Órdenes Mensuales / Saldo Promedio
Indice Saturacion = 
    DIVIDE(
        [Compromiso Ordenes],
        CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Operacion)),
        0
    )

// Clientes con Índice de Saturación mayor a 0.5 (47 clientes sobreendeudados)
Clientes Saturados = 
    COUNTROWS(
        FILTER(
            VALUES(Dim_Cliente[sk_cliente]),
            [Indice Saturacion] > 0.5
        )
    )

// Clientes con quiebra histórica en Estado B (31 clientes)
Clientes con Impago = 
    CALCULATE(
        DISTINCTCOUNT(Fact_Prestamos[sk_cliente]),
        Dim_Estado_Prestamo[codigo_estado] = "B"
    )

// Total de clientes (5,369)
Clientes Totales = COUNTROWS(Dim_Cliente)


// ==============================================================================
// 5. TÍTULOS DINÁMICOS PARA NAVEGACIÓN Y DRILL-THROUGH (D1, D2)
// ==============================================================================

Titulo Distrito = "Detalle del distrito: " & SELECTEDVALUE(Dim_Distrito[nombre_distrito], "(Seleccione un distrito)")

Titulo Cliente = "Ficha 360 · " & SELECTEDVALUE(Dim_Cliente[Cliente], "(Seleccione un cliente)")

// ==============================================================================
// EQUIVALENTE PARA MONGODB (Se sustituye Fact_* por m_* con idéntico nombre de medida)
// Ejemplo: Cartera Total = SUM(m_prestamos[monto_prestamo])
//          Saldo Depositos = SUM(m_saldo_cuenta[saldo_final])
//          Volumen Transaccionado = SUM(m_trans_anual[monto_total])
// ==============================================================================
