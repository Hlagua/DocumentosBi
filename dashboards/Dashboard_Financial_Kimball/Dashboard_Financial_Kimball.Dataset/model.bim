                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"modelo\", type text}, {\"familia\", type text}, {\"rol\", type text}, {\"hit_1\", type number}, {\"hit_3\", type number}, {\"mrr\", type number}, {\"hit_1_cola_larga\", type number}, {\"mrr_confirmacion\", type number}, {\"orden\", Int64.Type}, {\"elegido\", type logical}})",
                "in",
                "    Tipos"
              ],
              "type": "m"
            }
          }
        ]
      },
