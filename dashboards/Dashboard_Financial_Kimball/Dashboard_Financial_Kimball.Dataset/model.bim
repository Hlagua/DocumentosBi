          {
            "type": "calculated",
            "name": "Cliente",
            "dataType": "string",
            "expression": "\"Cliente \" & Dim_Cliente[id_cliente_bk]",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Segmento Edad",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), Dim_Cliente[edad_corte] <= 25, \"Joven (<=25)\", Dim_Cliente[edad_corte] <= 40, \"Adulto joven (26-40)\", Dim_Cliente[edad_corte] <= 60, \"Adulto (41-60)\", \"Mayor (>60)\")",
            "summarizeBy": "none"
          }
        ],
