                "    Columnas = Table.SelectColumns(Tabla, {\"sk_cliente\", \"id_cliente_bk\", \"sexo\", \"edad_corte\", \"tipo_disposicion\", \"segmento_edad\", \"arquetipo_demografico\", \"calificacion_pago_desc\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_cliente\", Int64.Type}, {\"id_cliente_bk\", Int64.Type}, {\"sexo\", type text}, {\"edad_corte\", Int64.Type}, {\"tipo_disposicion\", type text}, {\"segmento_edad\", type text}, {\"arquetipo_demografico\", type text}, {\"calificacion_pago_desc\", type text}}),",
                "    Orden = Table.AddColumn(Tipos, \"Orden Segmento\", each if Text.Contains([segmento_edad], \"Joven\") then 1 else if Text.Contains([segmento_edad], \"Mayor\") then 3 else if Text.Contains([segmento_edad], \"Adulto\") then 2 else 0, Int64.Type)",
                "in",
                "    Orden"
              ],
              "type": "m"
            }
