        "name": "Regla_Capacidad",
        "columns": [
          {
            "name": "regla",
            "dataType": "string",
            "sourceColumn": "regla",
            "summarizeBy": "none"
          },
          {
            "name": "tramo",
            "dataType": "string",
            "sourceColumn": "tramo",
            "summarizeBy": "none",
            "sortByColumn": "orden"
          },
          {
            "name": "orden",
            "dataType": "int64",
            "sourceColumn": "orden",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "prestamos",
            "dataType": "int64",
            "sourceColumn": "prestamos",
            "summarizeBy": "none"
          },
          {
            "name": "impagos",
            "dataType": "int64",
            "sourceColumn": "impagos",
            "summarizeBy": "none"
          },
          {
            "name": "tasa_impago",
            "dataType": "double",
            "sourceColumn": "tasa_impago",
            "summarizeBy": "none",
            "formatString": "0.00%"
          },
          {
            "name": "auc",
            "dataType": "double",
            "sourceColumn": "auc",
            "summarizeBy": "none",
            "formatString": "0.000"
          }
        ],
        "partitions": [
          {
            "name": "Regla_Capacidad",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"Regla_Capacidad\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"regla\", \"tramo\", \"orden\", \"prestamos\", \"impagos\", \"tasa_impago\", \"auc\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"regla\", type text}, {\"tramo\", type text}, {\"orden\", Int64.Type}, {\"prestamos\", Int64.Type}, {\"impagos\", Int64.Type}, {\"tasa_impago\", type number}, {\"auc\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Composicion_Liquidez",
        "columns": [
          {
            "name": "concepto",
            "dataType": "string",
            "sourceColumn": "concepto",
            "summarizeBy": "none",
            "sortByColumn": "orden"
          },
          {
            "name": "orden",
            "dataType": "int64",
            "sourceColumn": "orden",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Composicion_Liquidez",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [concepto = text, orden = Int64.Type], {{\"Saldo neto al corte\", 1}, {\"Cartera vigente\", 2}})",
                "in",
                "    Origen"
              ]
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Medidas",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Medidas",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [Medidas = text], {{\"Guía 07 v4\"}})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Num Prestamos",
            "expression": "COUNTROWS(Fact_Prestamos)",
            "description": "Préstamos otorgados (682)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos en Mora",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = \"D\")",
            "description": "Vigentes en mora, estado D (45)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Vigentes",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {\"C\", \"D\"})",
            "description": "Estados C + D (448)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Incumplidos",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "description": "Cerrados con deuda, estado B (31)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Cerrados",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {\"A\", \"B\"})",
            "description": "Estados A + B (234)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos con Impago",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {\"B\", \"D\"})",
            "description": "Estados B + D (76)",
            "formatString": "#,0"
          },
          {
            "name": "Tasa Mora Vigente",
            "expression": "IF([Prestamos Vigentes] > 0, DIVIDE([Prestamos en Mora] + 0, [Prestamos Vigentes]))",
            "description": "D / (C + D) = 10.04%; 0% (no vacío) si hay vigentes sin mora, p. ej. north Bohemia 0/41",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Incumplimiento",
            "expression": "IF([Prestamos Cerrados] > 0, DIVIDE([Prestamos Incumplidos] + 0, [Prestamos Cerrados]))",
            "description": "B / (A + B) = 13.25%",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Impago",
            "expression": "IF([Num Prestamos] > 0, DIVIDE([Prestamos con Impago] + 0, [Num Prestamos]))",
            "description": "(B + D) / total = 11.14%; es la tasa de P6 por banda de capacidad",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Wilson Inferior",
            "expression": "VAR n = [Prestamos Vigentes] VAR p = DIVIDE([Prestamos en Mora] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "description": "Límite inferior de Wilson (z = 1) de mora",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Wilson Superior",
            "expression": "VAR n = [Prestamos Vigentes] VAR p = DIVIDE([Prestamos en Mora] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "description": "Límite superior de Wilson (z = 1) de mora",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Wilson Inferior",
            "expression": "VAR n = [Prestamos Cerrados] VAR p = DIVIDE([Prestamos Incumplidos] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "description": "Límite inferior de Wilson (z = 1) de incumplimiento",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Wilson Superior",
            "expression": "VAR n = [Prestamos Cerrados] VAR p = DIVIDE([Prestamos Incumplidos] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "description": "Límite superior de Wilson (z = 1) de incumplimiento",
            "formatString": "0.00%"
          },
          {
            "name": "Impago Wilson Inferior",
            "expression": "VAR n = [Num Prestamos] VAR p = DIVIDE([Prestamos con Impago] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "description": "Límite inferior de Wilson (z = 1) de impago",
            "formatString": "0.00%"
          },
          {
            "name": "Impago Wilson Superior",
            "expression": "VAR n = [Num Prestamos] VAR p = DIVIDE([Prestamos con Impago] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "description": "Límite superior de Wilson (z = 1) de impago",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Mora Banco",
            "expression": "CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(Dim_Distrito))",
            "description": "Referencia de P2: la tasa del banco, sin el filtro de distrito",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Impago Banco",
            "expression": "CALCULATE([Tasa Impago], REMOVEFILTERS(Fact_Prestamos[banda_capacidad], Fact_Prestamos[Orden Banda]))",
            "description": "Referencia de P6: impago de todas las bandas",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Incumplimiento Banco",
            "expression": "CALCULATE([Tasa Incumplimiento], REMOVEFILTERS(Dim_Cliente))",
            "description": "Referencia de P6: incumplimiento de todos los segmentos de edad",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Impago Banda Baja",
            "expression": "CALCULATE([Tasa Impago], KEEPFILTERS(Fact_Prestamos[banda_capacidad] = \"Baja\"))",
            "description": "Impago de la banda Baja (2.92%); KEEPFILTERS respeta los demás filtros",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Impago Banda Alta",
            "expression": "CALCULATE([Tasa Impago], KEEPFILTERS(Fact_Prestamos[banda_capacidad] = \"Alta\"))",
            "description": "Impago de la banda Alta (23.26%)",
            "formatString": "0.00%"
          },
          {
            "name": "Cartera Total",
            "expression": "SUM(Fact_Prestamos[monto_prestamo])",
            "description": "Monto original de todos los préstamos ($103,261,740)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cartera Vigente",
            "expression": "CALCULATE([Cartera Total], Dim_Estado_Prestamo[codigo_estado] IN {\"C\", \"D\"})",
            "description": "Monto original C + D ($80,296,176)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo por Cobrar Estimado",
            "expression": "CALCULATE(SUM(Fact_Prestamos[saldo_pendiente_estimado]), Dim_Estado_Prestamo[codigo_estado] IN {\"C\", \"D\"})",
            "description": "Capital pendiente estimado de la cartera vigente ($46,620,926)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Original en Riesgo",
            "expression": "CALCULATE([Cartera Total], Dim_Estado_Prestamo[codigo_estado] IN {\"B\", \"D\"})",
            "description": "Monto original de los préstamos B + D ($15,580,152)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Incumplido",
            "expression": "CALCULATE([Cartera Total], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "description": "Monto original de los préstamos B",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cuota Mensual",
            "expression": "SUM(Fact_Prestamos[pago_mensual])",
            "description": "Cuota mensual de los préstamos del contexto",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Clientes con Impago",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Prestamos[sk_cliente]), Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "description": "Titulares con préstamo B (31): lista de denegación",
            "formatString": "#,0"
          },
          {
            "name": "Cartera Distritos Sobre Mora Banco",
            "expression": "VAR moraBanco = CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(Dim_Distrito)) RETURN CALCULATE([Cartera Vigente], FILTER(VALUES(Dim_Distrito[nombre_distrito]), [Tasa Mora Vigente] > moraBanco))",
            "description": "CALCULATE + FILTER: cartera vigente de los distritos con mora sobre la del banco",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Distritos Sobre Mora Banco",
            "expression": "VAR moraBanco = CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(Dim_Distrito)) RETURN COUNTROWS(FILTER(VALUES(Dim_Distrito[nombre_distrito]), [Tasa Mora Vigente] > moraBanco))",
            "description": "Distritos con tasa de mora vigente sobre la del banco",
            "formatString": "#,0"
          },
          {
            "name": "Region Mayor Mora",
            "expression": "VAR r = TOPN(1, FILTER(VALUES(Dim_Distrito[region]), [Prestamos Vigentes] > 0), [Tasa Mora Vigente], DESC) RETURN CONCATENATEX(r, Dim_Distrito[region] & \" · \" & FORMAT([Tasa Mora Vigente], \"0.0%\"), \", \")",
            "description": "north Moravia · 15.8%"
          },
          {
            "name": "Distrito Mayor Morosos",
            "expression": "VAR d = TOPN(1, FILTER(VALUES(Dim_Distrito[nombre_distrito]), [Prestamos en Mora] > 0), [Prestamos en Mora], DESC) RETURN CONCATENATEX(d, Dim_Distrito[nombre_distrito] & \" · \" & [Prestamos en Mora] & \" en mora\", \", \")",
            "description": "Hl.m. Praha · 4 en mora"
          },
          {
            "name": "Estado Prestamo",
            "expression": "IF([Num Prestamos] > 0, CALCULATE(CONCATENATEX(VALUES(Dim_Estado_Prestamo[Estado]), Dim_Estado_Prestamo[Estado], \", \"), Fact_Prestamos))",
            "description": "Estado del préstamo del cliente o de la cuenta (fichas)"
          },
          {
            "name": "Banda Capacidad",
            "expression": "IF([Num Prestamos] > 0, CONCATENATEX(VALUES(Fact_Prestamos[banda_capacidad]), Fact_Prestamos[banda_capacidad], \", \"))",
            "description": "Banda de capacidad de pago (ratio cuota / saldo previo)"
          },
          {
            "name": "Distrito Prestamo",
            "expression": "IF([Num Prestamos] > 0, CALCULATE(CONCATENATEX(VALUES(Dim_Distrito[nombre_distrito]), Dim_Distrito[nombre_distrito], \", \"), Fact_Prestamos))",
            "description": "Distrito de la cuenta del préstamo"
          },
          {
            "name": "Banda Capacidad Impago",
            "expression": "CALCULATE([Banda Capacidad], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "description": "Banda del préstamo B (lista de P6)"
          },
          {
            "name": "Distrito Impago",
            "expression": "CALCULATE([Distrito Prestamo], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "description": "Distrito del préstamo B (lista de P6)"
          },
          {
            "name": "Saldo Neto Corte",
            "expression": "VAR ultimoMes = CALCULATE(MAX(Dim_Tiempo[fecha]), Fact_Saldo_Cuenta_Mensual) RETURN CALCULATE(SUM(Fact_Saldo_Cuenta_Mensual[saldo_fin_mes]), FILTER(ALL(Dim_Tiempo), Dim_Tiempo[fecha] = ultimoMes))",
            "description": "Saldo al cierre del último mes del contexto ($197,140,434 en dic-1998)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cuentas Activas Corte",
            "expression": "VAR ultimoMes = CALCULATE(MAX(Dim_Tiempo[fecha]), Fact_Saldo_Cuenta_Mensual) RETURN CALCULATE(COUNTROWS(Fact_Saldo_Cuenta_Mensual), FILTER(ALL(Dim_Tiempo), Dim_Tiempo[fecha] = ultimoMes))",
            "description": "Cuentas con foto en el último mes del contexto (4,500 en dic-1998)",
            "formatString": "#,0"
          },
          {
            "name": "Cuentas en Sobregiro",
            "expression": "VAR ultimoMes = CALCULATE(MAX(Dim_Tiempo[fecha]), Fact_Saldo_Cuenta_Mensual) RETURN CALCULATE(CALCULATE(COUNTROWS(Fact_Saldo_Cuenta_Mensual), Fact_Saldo_Cuenta_Mensual[en_sobregiro] = TRUE()), FILTER(ALL(Dim_Tiempo), Dim_Tiempo[fecha] = ultimoMes))",
            "description": "Cuentas con saldo negativo al cierre del último mes (39 en dic-1998)",
            "formatString": "#,0"
          },
          {
            "name": "Saldo Promedio por Cuenta",
            "expression": "DIVIDE([Saldo Neto Corte], [Cuentas Activas Corte])",
            "description": "Saldo por cuenta activa: aísla el crecimiento por apertura de cuentas",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo Promedio Banco",
            "expression": "CALCULATE([Saldo Promedio por Cuenta], REMOVEFILTERS(Dim_Distrito))",
            "description": "Referencia gris de D1",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Umbral Sobregiro",
            "expression": "IF(NOT ISBLANK([Saldo Neto Corte]), 0)",
            "description": "Línea en 0 de la ficha D2",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Saldo Neto Corte Total",
            "expression": "CALCULATE([Saldo Neto Corte], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo))",
            "description": "Saldo al corte dic-1998, sin importar el año elegido",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cartera Vigente Corte",
            "expression": "CALCULATE([Cartera Vigente], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo))",
            "description": "Cartera vigente al corte, sin importar el año elegido",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Absorcion Vigente",
            "expression": "DIVIDE([Cartera Vigente Corte], [Saldo Neto Corte Total])",
            "description": "KPI de liquidez de la Carta v8: cartera vigente / saldo neto al corte (40.73%)",
            "formatString": "0.00%"
          },
          {
            "name": "Absorcion Cartera Total",
            "expression": "DIVIDE(CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo)), [Saldo Neto Corte Total])",
            "description": "Referencia histórica: cartera total / saldo neto (52.38%)",
            "formatString": "0.00%"
          },
          {
            "name": "Absorcion Banco",
            "expression": "CALCULATE([Absorcion Vigente], REMOVEFILTERS(Dim_Distrito))",
            "description": "Referencia de P3: absorción del banco",
            "formatString": "0.00%"
          },
          {
            "name": "Liquidez Libre",
            "expression": "[Saldo Neto Corte Total] - [Cartera Vigente Corte]",
            "description": "Saldo que no respalda cartera vigente ($116,844,258)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Valor Composicion Liquidez",
            "expression": "SWITCH(SELECTEDVALUE(Composicion_Liquidez[concepto]), \"Saldo neto al corte\", [Saldo Neto Corte Total], \"Cartera vigente\", -[Cartera Vigente Corte])",
            "description": "Cascada de P3; el total es la liquidez libre",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Volumen Transaccionado",
            "expression": "SUM(vw_PBI_Trans_Anual_Cuenta[monto_total])",
            "description": "$6,257,862,197",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Transacciones",
            "expression": "SUM(vw_PBI_Trans_Anual_Cuenta[num_transacciones])",
            "description": "1,056,320",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Promedio",
            "expression": "DIVIDE([Volumen Transaccionado], [Num Transacciones])",
            "description": "Monto promedio por movimiento",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Desv Est Transaccion",
            "expression": "VAR n = [Num Transacciones] VAR s = [Volumen Transaccionado] VAR sq = SUM(vw_PBI_Trans_Anual_Cuenta[suma_cuadrados]) RETURN IF(n > 1, SQRT(DIVIDE(sq - s * s / n, n - 1)))",
            "description": "σ muestral exacta desde la suma y la suma de cuadrados",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Ticket Limite Superior",
            "expression": "[Ticket Promedio] + [Desv Est Transaccion]",
            "description": "Promedio + 1σ",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Ticket Limite Inferior",
            "expression": "MAX(0, [Ticket Promedio] - [Desv Est Transaccion])",
            "description": "Promedio − 1σ (no negativo)",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "EE Ticket",
            "expression": "DIVIDE([Desv Est Transaccion], SQRT([Num Transacciones]))",
            "description": "Error estándar (tooltip)",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Saldo Promedio Historico",
            "expression": "DIVIDE(SUMX(vw_PBI_Trans_Anual_Cuenta, vw_PBI_Trans_Anual_Cuenta[saldo_promedio] * vw_PBI_Trans_Anual_Cuenta[num_transacciones]), [Num Transacciones])",
            "description": "Saldo promedio de la cuenta ponderado por movimientos",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Compromiso Ordenes",
            "expression": "SUM(Fact_Ordenes[monto_orden])",
            "description": "Órdenes fijas mensuales ($21,229,041)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Ordenes",
            "expression": "COUNTROWS(Fact_Ordenes)",
            "description": "6,471 órdenes",
            "formatString": "#,0"
          },
          {
            "name": "Pct Ordenes",
            "expression": "DIVIDE([Num Ordenes], CALCULATE([Num Ordenes], REMOVEFILTERS(Dim_Orden[categoria_orden_traducida])))",
            "description": "Participación de cada propósito",
            "formatString": "0.00%"
          },
          {
            "name": "Indice Saturacion",
            "expression": "DIVIDE([Compromiso Ordenes], CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo), REMOVEFILTERS(vw_PBI_Trans_Anual_Cuenta[categoria_analitica])))",
            "description": "Órdenes mensuales / saldo promedio histórico de la cuenta (cuenta 2335: 2.14)",
            "formatString": "0.00"
          },
          {
            "name": "Cuentas Saturadas",
            "expression": "COUNTROWS(FILTER(VALUES(Dim_Cuenta[id_cuenta_bk]), [Indice Saturacion] > 0.5))",
            "description": "CALCULATE + FILTER: cuentas con índice > 0.5 (47)",
            "formatString": "#,0"
          },
          {
            "name": "Cuentas Sobre Saldo",
            "expression": "COUNTROWS(FILTER(VALUES(Dim_Cuenta[id_cuenta_bk]), [Indice Saturacion] > 1))",
            "description": "Cuentas cuyas órdenes superan su saldo promedio (1)",
            "formatString": "#,0"
          },
          {
            "name": "Cuentas con Credito Externo",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Ordenes[sk_cuenta]), Dim_Cuenta[tiene_credito_externo] = TRUE())",
            "description": "Cuentas que pagan un préstamo a otra entidad (35)",
            "formatString": "#,0"
          },
          {
            "name": "Credito Externo Mensual",
            "expression": "CALCULATE([Compromiso Ordenes], Dim_Cuenta[tiene_credito_externo] = TRUE(), Dim_Orden[k_symbol_original] = \"UVER\")",
            "description": "Cuotas mensuales a otras entidades ($177,154)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Indice Saturacion Alerta",
            "expression": "VAR i = [Indice Saturacion] RETURN IF(i > 0.5, i)",
            "description": "Solo cuentas en alerta",
            "formatString": "0.00"
          },
          {
            "name": "Compromiso Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Compromiso Ordenes])",
            "description": "Solo cuentas en alerta",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo Promedio Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo), REMOVEFILTERS(vw_PBI_Trans_Anual_Cuenta[categoria_analitica])))",
            "description": "Solo cuentas en alerta",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Credito Externo Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Credito Externo Mensual])",
            "description": "Solo cuentas en alerta",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cliente Titular Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, CALCULATE(SELECTEDVALUE(Dim_Cliente[Cliente]), Fact_Saldo_Cuenta_Mensual))",
            "description": "Solo cuentas en alerta"
          },
          {
            "name": "Cuenta Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, CALCULATE(SELECTEDVALUE(Dim_Cuenta[Cuenta]), Fact_Saldo_Cuenta_Mensual))",
            "description": "Cuenta del titular en alerta"
          },
          {
            "name": "Titulo Distrito",
            "expression": "\"Distrito: \" & SELECTEDVALUE(Dim_Distrito[nombre_distrito], \"(varios)\") & \" (\" & SELECTEDVALUE(Dim_Distrito[region], \"varias regiones\") & \")\"",
            "description": "Título dinámico de D1"
          },
          {
            "name": "Region del Distrito",
            "expression": "SELECTEDVALUE(Dim_Distrito[region])",
            "description": "Región del distrito (tooltip del treemap de P2)"
          },
          {
            "name": "Poblacion Distrito",
            "expression": "SELECTEDVALUE(Dim_Distrito[poblacion])",
            "description": "Habitantes",
            "formatString": "#,0"
          },
          {
            "name": "Salario Promedio Distrito",
            "expression": "SELECTEDVALUE(Dim_Distrito[salario_promedio])",
            "description": "Salario promedio",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Desempleo Distrito 1995",
            "expression": "SELECTEDVALUE(Dim_Distrito[tasa_desempleo])",
            "description": "Tasa de desempleo 1995 (%)",
            "formatString": "0.00"
          },
          {
            "name": "Origen Indicadores",
            "expression": "IF(HASONEVALUE(Dim_Distrito[es_imputado]), IF(VALUES(Dim_Distrito[es_imputado]), \"Imputado (Informe 10)\", \"Fuente original\"))",
            "description": "Marca el distrito 69 con indicadores imputados"
          },
          {
            "name": "Cliente Ficha",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cliente[Cliente]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Titular de la cuenta (vale si se llega por cliente o por cuenta)"
          },
          {
            "name": "Cuenta Ficha",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cuenta[Cuenta]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Cuenta del titular"
          },
          {
            "name": "Titulo Cliente",
            "expression": "\"Ficha 360 · \" & COALESCE([Cliente Ficha], SELECTEDVALUE(Dim_Cliente[Cliente], \"(varios clientes)\")) & \" · \" & COALESCE([Cuenta Ficha], \"sin cuenta propia\")",
            "description": "Título dinámico de D2"
          },
          {
            "name": "Edad Cliente",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cliente[edad_corte]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Edad al 31/12/1998",
            "formatString": "#,0"
          },
          {
            "name": "Segmento Cliente",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cliente[segmento_edad]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Segmento de edad (3 grupos del Data Mart)"
          },
          {
            "name": "Arquetipo Cliente",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cliente[arquetipo_demografico]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Macro-región y segmento"
          },
          {
            "name": "Calificacion Cliente",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Cliente[calificacion_pago_desc]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Buen / Mal pagador / Sin evaluar"
          },
          {
            "name": "Distrito Cuenta",
            "expression": "CALCULATE(SELECTEDVALUE(Dim_Distrito[nombre_distrito]), Fact_Saldo_Cuenta_Mensual)",
            "description": "Distrito de la cuenta"
          },
          {
            "name": "Cuota Maxima Prudente",
            "expression": "SUM(Recomendacion_Cuenta[prestamo_cuota_maxima])",
            "description": "Cuota que deja el ratio en la banda Baja (Informe 04)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Maximo Prudente",
            "expression": "SUM(Recomendacion_Cuenta[prestamo_monto_maximo_36m])",
            "description": "Monto a 36 meses con esa cuota (Informe 04)",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Recomendaciones Demograficas",
            "expression": "CALCULATE(COUNTROWS(Recomendacion_Producto), Recomendacion_Producto[sistema] = \"Demográfico\")",
            "description": "Productos en el top 3 del recomendador demográfico (el más preciso: Hit@1 66.0%)",
            "formatString": "#,0"
          },
          {
            "name": "Primera Opcion",
            "expression": "CALCULATE([Recomendaciones Demograficas], Recomendacion_Producto[posicion] = 1)",
            "description": "Veces que el producto es la primera recomendación",
            "formatString": "#,0"
          },
          {
            "name": "Recomendaciones kNN",
            "expression": "CALCULATE(COUNTROWS(Recomendacion_Producto), Recomendacion_Producto[sistema] = \"kNN perfil\")",
            "description": "Productos en el top 3 del kNN por perfil exógeno",
            "formatString": "#,0"
          },
          {
            "name": "Descubrimientos kNN",
            "expression": "CALCULATE([Recomendaciones kNN], Recomendacion_Producto[es_descubrimiento] = TRUE())",
            "description": "Ofertas del kNN que el demográfico no tiene en su top 3 (2,731)",
            "formatString": "#,0"
          },
          {
            "name": "Clientes con Recomendacion",
            "expression": "CALCULATE(DISTINCTCOUNT(Recomendacion_Producto[sk_cuenta]), Recomendacion_Producto[sistema] = \"Demográfico\")",
            "description": "Titulares con al menos una recomendación",
            "formatString": "#,0"
          },
          {
            "name": "Cuentas que ya lo Usan",
            "expression": "COUNTROWS(Adopcion_Producto)",
            "description": "Cuentas que ya usan el producto (adopción actual)",
            "formatString": "#,0"
          },
          {
            "name": "Titulares",
            "expression": "COUNTROWS(Capacidad_Prestamo)",
            "description": "Titulares (una cuenta cada uno: 4,500)",
            "formatString": "#,0"
          },
          {
            "name": "Penetracion Actual",
            "expression": "DIVIDE([Cuentas que ya lo Usan], [Titulares])",
            "description": "Cuentas que ya usan el producto / titulares del contexto",
            "formatString": "0.00%"
          },
          {
            "name": "Producto Mas Recomendado",
            "expression": "VAR x = TOPN(1, VALUES(Dim_Producto[producto]), [Primera Opcion], DESC) RETURN CONCATENATEX(x, Dim_Producto[producto] & \" · \" & FORMAT([Primera Opcion], \"#,0\"), \", \")",
            "description": "Primera recomendación más frecuente en el contexto"
          },
          {
            "name": "Recomendacion 1",
            "expression": "CALCULATE(SELECTEDVALUE(Recomendacion_Producto[producto]), Recomendacion_Producto[sistema] = \"Demográfico\", Recomendacion_Producto[posicion] = 1)",
            "description": "Primera recomendación del titular"
          },
          {
            "name": "Recomendacion 2",
            "expression": "CALCULATE(SELECTEDVALUE(Recomendacion_Producto[producto]), Recomendacion_Producto[sistema] = \"Demográfico\", Recomendacion_Producto[posicion] = 2)",
            "description": "Segunda recomendación del titular"
          },
          {
            "name": "Recomendacion 3",
            "expression": "CALCULATE(SELECTEDVALUE(Recomendacion_Producto[producto]), Recomendacion_Producto[sistema] = \"Demográfico\", Recomendacion_Producto[posicion] = 3)",
            "description": "Tercera recomendación del titular"
          },
          {
            "name": "Descubrimiento kNN",
            "expression": "CALCULATE(CONCATENATEX(VALUES(Recomendacion_Producto[producto]), Recomendacion_Producto[producto], \", \"), Recomendacion_Producto[sistema] = \"kNN perfil\", Recomendacion_Producto[es_descubrimiento] = TRUE())",
            "description": "Productos que el kNN añade para el titular"
          },
          {
            "name": "Acierto Elegido",
            "expression": "CALCULATE(MAX(Evaluacion_Recomendador[hit_1]), Evaluacion_Recomendador[modelo] = \"Demográfico (arquetipo)\")",
            "description": "Hit@1 del demográfico (66.0%, semilla 42)",
            "formatString": "0.00%"
          },
          {
            "name": "Acierto Popularidad",
            "expression": "CALCULATE(MAX(Evaluacion_Recomendador[hit_1]), Evaluacion_Recomendador[modelo] = \"Popularidad\")",
            "description": "Hit@1 de recomendar lo más popular (58.5%): la línea base",
            "formatString": "0.00%"
          },
          {
            "name": "Acierto Cola Larga kNN",
            "expression": "CALCULATE(MAX(Evaluacion_Recomendador[hit_1_cola_larga]), Evaluacion_Recomendador[modelo] = \"kNN usuario-usuario (perfil exógeno)\")",
            "description": "Hit@1 del kNN en productos poco comunes (37.2%)",
            "formatString": "0.00%"
          },
          {
            "name": "Acierto Cola Larga Popularidad",
            "expression": "CALCULATE(MAX(Evaluacion_Recomendador[hit_1_cola_larga]), Evaluacion_Recomendador[modelo] = \"Popularidad\")",
            "description": "Hit@1 de la popularidad en productos poco comunes (6.3%)",
            "formatString": "0.00%"
          },
          {
            "name": "Acierto Hit1",
            "expression": "SUM(Evaluacion_Recomendador[hit_1])",
            "description": "Hit@1 del modelo (gráfico comparativo)",
            "formatString": "0.00%"
          },
          {
            "name": "Acierto Cola Larga",
            "expression": "SUM(Evaluacion_Recomendador[hit_1_cola_larga])",
            "description": "Hit@1 en la cola larga (gráfico comparativo)",
            "formatString": "0.00%"
          },
          {
            "name": "MRR Modelo",
            "expression": "SUM(Evaluacion_Recomendador[mrr])",
            "description": "Rango recíproco medio",
            "formatString": "0.000"
          },
          {
            "name": "MRR Confirmacion",
            "expression": "SUM(Evaluacion_Recomendador[mrr_confirmacion])",
            "description": "MRR con la semilla 2026",
            "formatString": "0.000"
          },
          {
            "name": "Titulares sin Prestamo",
            "expression": "CALCULATE([Titulares], Capacidad_Prestamo[tiene_prestamo] = FALSE())",
            "description": "3,818",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Prudentes Recomendados",
            "expression": "CALCULATE([Titulares], Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Titulares con préstamo en su top 3 (1,721)",
            "formatString": "#,0"
          },
          {
            "name": "Cuota Prudente Mediana",
            "expression": "CALCULATE(MEDIAN(Capacidad_Prestamo[cuota_prudente]), Capacidad_Prestamo[tiene_prestamo] = FALSE())",
            "description": "5.7% del saldo promedio, mediana de los titulares sin préstamo (1,873)",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Pueden Pagar Prestamo Tipico",
            "expression": "CALCULATE([Titulares], Capacidad_Prestamo[puede_pagar_prestamo_tipico] = TRUE())",
            "description": "Titulares sin préstamo cuya cuota prudente cubre la cuota mediana otorgada (71)",
            "formatString": "#,0"
          },
          {
            "name": "Monto Prudente Ofrecible 36m",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[monto_maximo_36m]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Suma de montos máximos a 36 meses de los préstamos recomendados",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo Promedio Oferta",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[saldo_promedio]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Saldo promedio del titular con préstamo recomendado",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cuota Prudente Oferta",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[cuota_prudente]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Cuota prudente del titular con préstamo recomendado",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto 12m Oferta",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[monto_maximo_12m]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Monto máximo a 12 meses",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto 36m Oferta",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[monto_maximo_36m]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Monto máximo a 36 meses",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto 60m Oferta",
            "expression": "CALCULATE(SUM(Capacidad_Prestamo[monto_maximo_60m]), Capacidad_Prestamo[prestamo_recomendado] = TRUE())",
            "description": "Monto máximo a 60 meses",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "AUC Regla",
            "expression": "MAX(Regla_Capacidad[auc])",
            "description": "AUC de la regla para predecir el impago",
            "formatString": "0.000"
          },
          {
            "name": "AUC Regla Elegida",
            "expression": "CALCULATE([AUC Regla], Regla_Capacidad[regla] = \"Carta v8: cuota / saldo previo\")",
            "description": "0.717",
            "formatString": "0.000"
          },
          {
            "name": "AUC Regla Anterior",
            "expression": "CALCULATE([AUC Regla], Regla_Capacidad[regla] = \"Anterior: cuota / salario del distrito\")",
            "description": "0.659",
            "formatString": "0.000"
          },
          {
            "name": "P Destino dado Origen",
            "expression": "SUM(Asociacion_Producto[p_destino_dado_origen])",
            "description": "De quienes tienen el producto de origen, % que también tiene el de destino",
            "formatString": "0.00%"
          },
          {
            "name": "Lift Asociacion",
            "expression": "SUM(Asociacion_Producto[lift])",
            "description": "Lift: > 1 van juntos más de lo esperado por azar",
            "formatString": "0.00"
          },
          {
            "name": "Regla Mas Fuerte",
            "expression": "VAR x = TOPN(1, FILTER(Asociacion_Producto, Asociacion_Producto[cuentas_ambos] >= 100), Asociacion_Producto[lift], DESC, Asociacion_Producto[p_destino_dado_origen], DESC) RETURN CONCATENATEX(x, Asociacion_Producto[producto_origen] & \" → \" & Asociacion_Producto[producto_destino] & \" · \" & FORMAT(Asociacion_Producto[p_destino_dado_origen], \"0.0%\"), \", \")",
            "description": "Par con mayor lift (al menos 100 cuentas), en la dirección de mayor P(j|i): Seguro → Transferencias 99.8%"
          },
          {
            "name": "Color Mora",
            "expression": "VAR x = [Tasa Mora Vigente] RETURN SWITCH(TRUE(), ISBLANK(x), \"#FFFFFF\", x < 0.05, \"#FBE3D3\", x < 0.10, \"#F2B48C\", x < 0.15, \"#E5813F\", \"#D55E00\")",
            "description": "Treemap de P2: escala secuencial blanco → bermellón por tasa de mora"
          },
          {
            "name": "Color Saturacion",
            "expression": "VAR x = [Indice Saturacion] RETURN IF(x > 1, \"#D55E00\", IF(x > 0.5, \"#E69F00\", \"#7F7F7F\"))",
            "description": "Dispersión de P5: bermellón > 1, naranja > 0.5, gris el resto"
          },
          {
            "name": "Color Modelo",
            "expression": "IF(SELECTEDVALUE(Evaluacion_Recomendador[elegido]) = TRUE(), \"#0072B2\", \"#BDBDBD\")",
            "description": "R1: modelos elegidos en azul, el resto en gris"
          },
          {
            "name": "Color Regla",
            "expression": "IF(SELECTEDVALUE(Regla_Capacidad[regla]) = \"Carta v8: cuota / saldo previo\", \"#0072B2\", \"#BDBDBD\")",
            "description": "R2: regla elegida en azul"
          }
        ]
      }
    ],
