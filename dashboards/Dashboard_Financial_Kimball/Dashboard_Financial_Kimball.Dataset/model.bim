              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"Fact_Prestamos\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"sk_prestamo\", \"sk_tiempo\", \"sk_cuenta\", \"sk_cliente\", \"sk_distrito\", \"sk_estado_prestamo\", \"id_prestamo_bk\", \"monto_prestamo\", \"plazo_meses\", \"pago_mensual\", \"meses_transcurridos_al_corte\", \"saldo_pendiente_estimado\", \"saldo_promedio_previo\", \"ratio_cuota_saldo_previo\", \"banda_capacidad\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_prestamo\", Int64.Type}, {\"sk_tiempo\", Int64.Type}, {\"sk_cuenta\", Int64.Type}, {\"sk_cliente\", Int64.Type}, {\"sk_distrito\", Int64.Type}, {\"sk_estado_prestamo\", Int64.Type}, {\"id_prestamo_bk\", Int64.Type}, {\"monto_prestamo\", type number}, {\"plazo_meses\", Int64.Type}, {\"pago_mensual\", type number}, {\"meses_transcurridos_al_corte\", Int64.Type}, {\"saldo_pendiente_estimado\", type number}, {\"saldo_promedio_previo\", type number}, {\"ratio_cuota_saldo_previo\", type number}, {\"banda_capacidad\", type text}}),",
                "    Orden = Table.AddColumn(Tipos, \"Orden Banda\", each if Text.Contains([banda_capacidad], \"Media-baja\") then 2 else if Text.Contains([banda_capacidad], \"Media-alta\") then 3 else if Text.Contains([banda_capacidad], \"Baja\") then 1 else if Text.Contains([banda_capacidad], \"Alta\") then 4 else 0, Int64.Type)",
