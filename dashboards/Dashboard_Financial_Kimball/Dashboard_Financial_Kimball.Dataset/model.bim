          },
          {
            "name": "segmento_edad",
            "dataType": "string",
            "sourceColumn": "segmento_edad",
            "summarizeBy": "none",
            "sortByColumn": "Orden Segmento"
          },
          {
            "name": "arquetipo_demografico",
            "dataType": "string",
            "sourceColumn": "arquetipo_demografico",
            "summarizeBy": "none"
          },
          {
            "name": "calificacion_pago_desc",
            "dataType": "string",
            "sourceColumn": "calificacion_pago_desc",
            "summarizeBy": "none"
          },
          {
            "name": "Orden Segmento",
            "dataType": "int64",
            "sourceColumn": "Orden Segmento",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "type": "calculated",
            "name": "Cliente",
            "dataType": "string",
            "expression": "\"Cliente \" & Dim_Cliente[id_cliente_bk]",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Estado del Prestamo",
            "dataType": "string",
            "expression": "VAR e = CALCULATE(MAX(Dim_Estado_Prestamo[Estado]), CALCULATETABLE(Fact_Prestamos)) RETURN IF(ISBLANK(e), \"Sin préstamo\", e)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Banda de Capacidad",
            "dataType": "string",
            "expression": "VAR b = CALCULATE(MAX(Fact_Prestamos[banda_capacidad]), CALCULATETABLE(Fact_Prestamos)) RETURN IF(ISBLANK(b), \"Sin préstamo\", b)",
            "summarizeBy": "none",
            "sortByColumn": "Orden Banda Cliente"
          },
          {
            "type": "calculated",
            "name": "Orden Banda Cliente",
            "dataType": "int64",
            "expression": "VAR o = CALCULATE(MAX(Fact_Prestamos[Orden Banda]), CALCULATETABLE(Fact_Prestamos)) RETURN IF(ISBLANK(o), 5, o)",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "type": "calculated",
            "name": "Alerta de Saturacion",
            "dataType": "string",
            "expression": "VAR i = [Indice Saturacion] RETURN SWITCH(TRUE(), ISBLANK(i), \"Sin órdenes\", i > 1, \"Crítica (> 1)\", i > 0.5, \"Alta (> 0.5)\", \"Normal\")",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Primera Oferta",
            "dataType": "string",
            "expression": "VAR x = CALCULATE(MAX(Recomendacion_Producto[producto]), Recomendacion_Producto[sistema] = \"Demográfico\", Recomendacion_Producto[posicion] = 1) RETURN IF(ISBLANK(x), \"Sin recomendación\", x)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Prestamo Recomendado",
            "dataType": "string",
            "expression": "IF(CALCULATE(COUNTROWS(Capacidad_Prestamo)) = 0, \"Sin cuenta propia\", IF(CALCULATE(COUNTROWS(Capacidad_Prestamo), Capacidad_Prestamo[prestamo_recomendado] = TRUE()) > 0, \"Sí\", \"No\"))",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Cliente",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"Dim_Cliente\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"sk_cliente\", \"id_cliente_bk\", \"sexo\", \"edad_corte\", \"tipo_disposicion\", \"segmento_edad\", \"arquetipo_demografico\", \"calificacion_pago_desc\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_cliente\", Int64.Type}, {\"id_cliente_bk\", Int64.Type}, {\"sexo\", type text}, {\"edad_corte\", Int64.Type}, {\"tipo_disposicion\", type text}, {\"segmento_edad\", type text}, {\"arquetipo_demografico\", type text}, {\"calificacion_pago_desc\", type text}}),",
                "    Orden = Table.AddColumn(Tipos, \"Orden Segmento\", each if Text.Contains([segmento_edad], \"Joven\") then 1 else if Text.Contains([segmento_edad], \"Mayor\") then 3 else if Text.Contains([segmento_edad], \"Adulto\") then 2 else 0, Int64.Type)",
                "in",
                "    Orden"
              ]
            }
          }
        ]
      },
