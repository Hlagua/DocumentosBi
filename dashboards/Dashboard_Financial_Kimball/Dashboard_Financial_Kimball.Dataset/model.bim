          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "poblacion",
            "dataType": "int64",
            "sourceColumn": "poblacion",
            "summarizeBy": "none"
          },
          {
            "name": "salario_promedio",
            "dataType": "double",
            "sourceColumn": "salario_promedio",
            "summarizeBy": "none",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "tasa_desempleo",
            "dataType": "double",
            "sourceColumn": "tasa_desempleo",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "tasa_criminalidad",
            "dataType": "double",
            "sourceColumn": "tasa_criminalidad",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "es_imputado",
            "dataType": "boolean",
            "sourceColumn": "es_imputado",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Macro Region",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), Dim_Distrito[region] = \"Prague\", \"Praga\", CONTAINSSTRING(Dim_Distrito[region], \"Moravia\"), \"Moravia\", \"Bohemia\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Distrito",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"Dim_Distrito\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"sk_distrito\", \"id_distrito_bk\", \"nombre_distrito\", \"region\", \"poblacion\", \"salario_promedio\", \"tasa_desempleo\", \"tasa_criminalidad\", \"es_imputado\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_distrito\", Int64.Type}, {\"id_distrito_bk\", Int64.Type}, {\"nombre_distrito\", type text}, {\"region\", type text}, {\"poblacion\", Int64.Type}, {\"salario_promedio\", type number}, {\"tasa_desempleo\", type number}, {\"tasa_criminalidad\", type number}, {\"es_imputado\", type logical}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
