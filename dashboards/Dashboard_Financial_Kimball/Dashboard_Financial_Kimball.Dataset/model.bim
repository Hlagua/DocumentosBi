          },
          {
            "type": "calculated",
            "name": "Estado",
            "dataType": "string",
            "expression": "SWITCH(Dim_Estado_Prestamo[codigo_estado], \"A\", \"A · Cerrado al día\", \"B\", \"B · Cerrado con deuda\", \"C\", \"C · Vigente al día\", \"D\", \"D · Vigente en mora\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
