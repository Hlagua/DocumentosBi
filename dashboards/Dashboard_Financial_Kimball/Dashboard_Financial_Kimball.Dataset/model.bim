            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"vw_PBI_Saldo_Final_Cuenta\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"sk_cuenta\", \"sk_cliente\", \"sk_distrito\", \"fecha_ultimo_movimiento\", \"saldo_final\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_cuenta\", Int64.Type}, {\"sk_cliente\", Int64.Type}, {\"sk_distrito\", Int64.Type}, {\"fecha_ultimo_movimiento\", type datetime}, {\"saldo_final\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Medidas",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Medidas",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [Medidas = text], {{\"Guía 07\"}})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cartera Total",
            "expression": "SUM(Fact_Prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Prestamos",
            "expression": "COUNTROWS(Fact_Prestamos)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos en Mora",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = \"D\")",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Vigentes",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {\"C\", \"D\"})",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Incumplidos",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Cerrados",
            "expression": "CALCULATE([Num Prestamos], Dim_Estado_Prestamo[codigo_estado] IN {\"A\", \"B\"})",
            "formatString": "#,0"
          },
          {
            "name": "Tasa Mora Vigente",
            "expression": "DIVIDE([Prestamos en Mora], [Prestamos Vigentes])",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Incumplimiento",
            "expression": "DIVIDE([Prestamos Incumplidos], [Prestamos Cerrados])",
            "formatString": "0.00%"
          },
          {
            "name": "Monto en Riesgo",
            "expression": "CALCULATE(SUM(Fact_Prestamos[saldo_pendiente_estimado]), Dim_Estado_Prestamo[codigo_estado] IN {\"B\", \"D\"})",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Incumplido",
            "expression": "CALCULATE([Cartera Total], Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Promedio Prestamo",
            "expression": "AVERAGE(Fact_Prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Desv Est Prestamo",
            "expression": "STDEV.S(Fact_Prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Prestamo Limite Superior",
            "expression": "[Monto Promedio Prestamo] + [Desv Est Prestamo]",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Prestamo Limite Inferior",
            "expression": "[Monto Promedio Prestamo] - [Desv Est Prestamo]",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "EE Prestamo",
            "expression": "DIVIDE([Desv Est Prestamo], SQRT([Num Prestamos]))",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cuota Mensual",
            "expression": "SUM(Fact_Prestamos[pago_mensual])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Plazo Meses",
            "expression": "MAX(Fact_Prestamos[plazo_meses])",
            "formatString": "#,0"
          },
          {
            "name": "Saldo Pendiente",
            "expression": "SUM(Fact_Prestamos[saldo_pendiente_estimado])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Distritos con Prestamos",
            "expression": "DISTINCTCOUNT(Fact_Prestamos[sk_distrito])",
            "formatString": "#,0"
          },
          {
            "name": "Clientes con Impago",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Prestamos[sk_cliente]), Dim_Estado_Prestamo[codigo_estado] = \"B\")",
            "formatString": "#,0"
          },
          {
            "name": "Saldo Depositos",
            "expression": "SUM(vw_PBI_Saldo_Final_Cuenta[saldo_final])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Ratio Absorcion",
            "expression": "DIVIDE(CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo)), [Saldo Depositos])",
            "formatString": "0.00%"
          },
          {
            "name": "Liquidez Libre",
            "expression": "[Saldo Depositos] - CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo))",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Volumen Transaccionado",
            "expression": "SUM(vw_PBI_Trans_Anual_Cuenta[monto_total])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Transacciones",
            "expression": "SUM(vw_PBI_Trans_Anual_Cuenta[num_transacciones])",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Promedio Transaccion",
            "expression": "DIVIDE([Volumen Transaccionado], [Num Transacciones])",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Desv Est Transaccion",
            "expression": "VAR n = [Num Transacciones] VAR s = [Volumen Transaccionado] VAR sq = SUM(vw_PBI_Trans_Anual_Cuenta[suma_cuadrados]) RETURN SQRT(DIVIDE(sq - s * s / n, n - 1))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Transaccion Limite Superior",
            "expression": "[Ticket Promedio Transaccion] + [Desv Est Transaccion]",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Transaccion Limite Inferior",
            "expression": "[Ticket Promedio Transaccion] - [Desv Est Transaccion]",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "EE Transaccion",
            "expression": "DIVIDE([Desv Est Transaccion], SQRT([Num Transacciones]))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Saldo Promedio Historico",
            "expression": "DIVIDE(SUMX(vw_PBI_Trans_Anual_Cuenta, vw_PBI_Trans_Anual_Cuenta[saldo_promedio] * vw_PBI_Trans_Anual_Cuenta[num_transacciones]), [Num Transacciones])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Compromiso Ordenes",
            "expression": "SUM(Fact_Ordenes[monto_orden])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Ordenes",
            "expression": "COUNTROWS(Fact_Ordenes)",
            "formatString": "#,0"
          },
          {
            "name": "Indice Saturacion",
            "expression": "DIVIDE([Compromiso Ordenes], CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(Dim_Anio), REMOVEFILTERS(Dim_Tiempo), REMOVEFILTERS(Dim_Operacion)))",
            "formatString": "0.00"
          },
          {
            "name": "Indice Saturacion Alerta",
            "expression": "VAR i = [Indice Saturacion] RETURN IF(i > 0.5, i)",
            "formatString": "0.00"
          },
          {
            "name": "Compromiso Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Compromiso Ordenes])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo Promedio Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Saldo Promedio Historico])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Clientes Saturados",
            "expression": "COUNTROWS(FILTER(VALUES(Dim_Cliente[sk_cliente]), [Indice Saturacion] > 0.5))",
            "formatString": "#,0"
          },
          {
            "name": "Clientes Totales",
            "expression": "COUNTROWS(Dim_Cliente)",
            "formatString": "#,0"
          },
          {
            "name": "EE Mora",
            "expression": "SQRT(DIVIDE([Tasa Mora Vigente] * (1 - [Tasa Mora Vigente]), [Prestamos Vigentes]))",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Limite Superior",
            "expression": "[Tasa Mora Vigente] + [EE Mora]",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Limite Inferior",
            "expression": "MAX(0, [Tasa Mora Vigente] - [EE Mora])",
            "formatString": "0.00%"
          },
          {
            "name": "EE Incumplimiento",
            "expression": "SQRT(DIVIDE([Tasa Incumplimiento] * (1 - [Tasa Incumplimiento]), [Prestamos Cerrados]))",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Limite Superior",
            "expression": "[Tasa Incumplimiento] + [EE Incumplimiento]",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Limite Inferior",
            "expression": "MAX(0, [Tasa Incumplimiento] - [EE Incumplimiento])",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Ordenes",
            "expression": "DIVIDE([Num Ordenes], CALCULATE([Num Ordenes], REMOVEFILTERS(Dim_Orden)))",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Volumen",
            "expression": "DIVIDE([Volumen Transaccionado], CALCULATE([Volumen Transaccionado], REMOVEFILTERS(Dim_Operacion)))",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Cartera",
            "expression": "DIVIDE([Cartera Total], CALCULATE([Cartera Total], REMOVEFILTERS(Dim_Distrito)))",
            "formatString": "0.00%"
          },
          {
            "name": "Region Mayor Mora",
            "expression": "VAR t = TOPN(1, VALUES(Dim_Distrito[region]), [Tasa Mora Vigente], DESC) RETURN MAXX(t, Dim_Distrito[region]) & \" · \" & FORMAT(MAXX(t, [Tasa Mora Vigente]), \"0.00%\")"
          },
          {
            "name": "Region Mayor Cartera",
            "expression": "VAR t = TOPN(1, VALUES(Dim_Distrito[region]), [Cartera Total], DESC) RETURN MAXX(t, Dim_Distrito[region]) & \" · \" & FORMAT(MAXX(t, [Pct Cartera]), \"0.0%\")"
          },
          {
            "name": "Region Mayor Absorcion",
            "expression": "VAR t = TOPN(1, VALUES(Dim_Distrito[region]), [Ratio Absorcion], DESC) RETURN MAXX(t, Dim_Distrito[region]) & \" · \" & FORMAT(MAXX(t, [Ratio Absorcion]), \"0.00%\")"
          },
          {
            "name": "Operacion Mayor Volumen",
            "expression": "VAR t = TOPN(1, VALUES(Dim_Operacion[tipo_operacion_traducido]), [Volumen Transaccionado], DESC) RETURN MAXX(t, Dim_Operacion[tipo_operacion_traducido]) & \" · \" & FORMAT(MAXX(t, [Pct Volumen]), \"0.00%\")"
          },
          {
            "name": "Categoria Principal Orden",
            "expression": "VAR t = TOPN(1, VALUES(Dim_Orden[categoria_orden_traducida]), [Num Ordenes], DESC) RETURN MAXX(t, Dim_Orden[categoria_orden_traducida]) & \" · \" & FORMAT(MAXX(t, [Pct Ordenes]), \"0.00%\")"
          },
          {
            "name": "Titulo Distrito",
            "expression": "\"Detalle del distrito: \" & SELECTEDVALUE(Dim_Distrito[nombre_distrito], \"(varios)\")"
          },
          {
            "name": "Titulo Cliente",
            "expression": "\"Ficha 360 · \" & SELECTEDVALUE(Dim_Cliente[Cliente], \"(varios clientes)\")"
          }
        ]
      }
    ],
