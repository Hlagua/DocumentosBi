{
  "name": "Dashboard_Financial_Kimball",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "es-ES",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-ES",
    "tables": [
      {
        "name": "Dim_Tiempo",
        "columns": [
          {
            "name": "sk_tiempo",
            "dataType": "int64",
            "sourceColumn": "sk_tiempo",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "anio",
            "dataType": "int64",
            "sourceColumn": "anio",
            "summarizeBy": "none"
          },
          {
            "name": "mes",
            "dataType": "int64",
            "sourceColumn": "mes",
            "summarizeBy": "none"
          },
          {
            "name": "nombre_mes",
            "dataType": "string",
            "sourceColumn": "nombre_mes",
            "summarizeBy": "none"
          },
          {
            "name": "es_fin_de_mes",
            "dataType": "boolean",
            "sourceColumn": "es_fin_de_mes",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Tiempo",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tabla = Origen{[Schema=\"dbo\", Item=\"Dim_Tiempo\"]}[Data],",
                "    Columnas = Table.SelectColumns(Tabla, {\"sk_tiempo\", \"fecha\", \"anio\", \"mes\", \"nombre_mes\", \"es_fin_de_mes\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"sk_tiempo\", Int64.Type}, {\"fecha\", type datetime}, {\"anio\", Int64.Type}, {\"mes\", Int64.Type}, {\"nombre_mes\", type text}, {\"es_fin_de_mes\", type logical}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim_Anio",
        "columns": [
          {
            "name": "anio",
            "dataType": "int64",
            "sourceColumn": "anio",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Anio",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Sql.Database(ServidorSQL, BaseDatosSQL),",
                "    Tiempo = Origen{[Schema=\"dbo\", Item=\"Dim_Tiempo\"]}[Data],",
                "    Anios = Table.Distinct(Table.SelectColumns(Tiempo, {\"anio\"})),",
                "    Tipos = Table.TransformColumnTypes(Anios, {{\"anio\", Int64.Type}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim_Distrito",
