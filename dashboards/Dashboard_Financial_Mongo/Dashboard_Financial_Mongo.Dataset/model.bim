                "    Columnas = Table.SelectColumns(Tabla, {\"id_cliente\", \"cliente\", \"sexo\", \"edad_corte\", \"segmento_edad\", \"tipo_disposicion\", \"calificacion_pago\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"id_cliente\", Int64.Type}, {\"cliente\", type text}, {\"sexo\", type text}, {\"edad_corte\", Int64.Type}, {\"segmento_edad\", type text}, {\"tipo_disposicion\", type text}, {\"calificacion_pago\", type text}})",
