                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"id_cuenta\", Int64.Type}, {\"id_cliente\", Int64.Type}, {\"id_distrito\", Int64.Type}, {\"tiene_prestamo\", type logical}, {\"saldo_promedio\", type number}, {\"cuota_prudente\", type number}, {\"monto_maximo_12m\", type number}, {\"monto_maximo_36m\", type number}, {\"monto_maximo_60m\", type number}, {\"tramo_monto_36m\", type text}, {\"orden_tramo\", Int64.Type}, {\"puede_pagar_prestamo_tipico\", type logical}, {\"prestamo_recomendado\", type logical}}, \"en-US\")",
