      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Medidas",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "047eda2e-e340-4f25-8366-fe088d9d05f5",
            "sourceColumn": "Medidas",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "58b5c70a-89eb-4b38-a92b-9dbe74609cca",
        "measures": [
          {
            "name": "Num Prestamos",
            "description": "Préstamos otorgados (682)",
            "expression": "COUNTROWS(m_prestamos)",
            "formatString": "#,0",
            "lineageTag": "674c4686-0853-4cdb-97cf-d9a59397f5e4"
          },
          {
            "name": "Prestamos en Mora",
            "description": "Vigentes en mora, estado D (45)",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] = \"D\")",
            "formatString": "#,0",
            "lineageTag": "d8058c21-ffce-4efc-94d9-07a0c6381535"
          },
          {
            "name": "Prestamos Vigentes",
            "description": "Estados C + D (448)",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] IN {\"C\", \"D\"})",
            "formatString": "#,0",
            "lineageTag": "937e73d9-7729-44f9-9046-d867c6b117dd"
          },
          {
            "name": "Prestamos Incumplidos",
            "description": "Cerrados con deuda, estado B (31)",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] = \"B\")",
            "formatString": "#,0",
            "lineageTag": "e1ab34b8-0c46-4124-8b9c-2f26779ae36f"
          },
          {
            "name": "Prestamos Cerrados",
            "description": "Estados A + B (234)",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] IN {\"A\", \"B\"})",
            "formatString": "#,0",
            "lineageTag": "caab6281-f572-4159-a5e9-82f800d55b37"
          },
          {
            "name": "Prestamos con Impago",
            "description": "Estados B + D (76)",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] IN {\"B\", \"D\"})",
            "formatString": "#,0",
            "lineageTag": "ca180a47-da8e-4a09-8324-4900069cb761"
          },
          {
            "name": "Tasa Mora Vigente",
            "description": "D / (C + D) = 10.04%; 0% (no vacío) si hay vigentes sin mora, p. ej. north Bohemia 0/41",
            "expression": "IF([Prestamos Vigentes] > 0, DIVIDE([Prestamos en Mora] + 0, [Prestamos Vigentes]))",
            "formatString": "0.00%",
            "lineageTag": "a347aeca-8039-4e68-aa85-54f136de35e3"
          },
          {
            "name": "Tasa Incumplimiento",
            "description": "B / (A + B) = 13.25%",
            "expression": "IF([Prestamos Cerrados] > 0, DIVIDE([Prestamos Incumplidos] + 0, [Prestamos Cerrados]))",
            "formatString": "0.00%",
            "lineageTag": "ca66ea07-8f37-4ec3-9ba0-9a5cee51436d"
          },
          {
            "name": "Tasa Impago",
            "description": "(B + D) / total = 11.14%; es la tasa de P6 por banda de capacidad",
            "expression": "IF([Num Prestamos] > 0, DIVIDE([Prestamos con Impago] + 0, [Num Prestamos]))",
            "formatString": "0.00%",
            "lineageTag": "c433af54-623a-4918-aed3-5e33aa61803b"
          },
          {
            "name": "Mora Wilson Inferior",
            "description": "Límite inferior de Wilson (z = 1) de mora",
            "expression": "VAR n = [Prestamos Vigentes] VAR p = DIVIDE([Prestamos en Mora] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "formatString": "0.00%",
            "lineageTag": "be0e8967-1efb-4fde-9a6d-f340018a6ee6"
          },
          {
            "name": "Mora Wilson Superior",
            "description": "Límite superior de Wilson (z = 1) de mora",
            "expression": "VAR n = [Prestamos Vigentes] VAR p = DIVIDE([Prestamos en Mora] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "formatString": "0.00%",
            "lineageTag": "5e92b08a-6957-470b-a005-b9ccfdf08836"
          },
          {
            "name": "Incumplimiento Wilson Inferior",
            "description": "Límite inferior de Wilson (z = 1) de incumplimiento",
            "expression": "VAR n = [Prestamos Cerrados] VAR p = DIVIDE([Prestamos Incumplidos] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "formatString": "0.00%",
            "lineageTag": "55c5054e-f903-46aa-8433-28a0dd681976"
          },
          {
            "name": "Incumplimiento Wilson Superior",
            "description": "Límite superior de Wilson (z = 1) de incumplimiento",
            "expression": "VAR n = [Prestamos Cerrados] VAR p = DIVIDE([Prestamos Incumplidos] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "formatString": "0.00%",
            "lineageTag": "a56113a3-7245-4300-95d0-afef24fa162a"
          },
          {
            "name": "Impago Wilson Inferior",
            "description": "Límite inferior de Wilson (z = 1) de impago",
            "expression": "VAR n = [Num Prestamos] VAR p = DIVIDE([Prestamos con Impago] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c - m)",
            "formatString": "0.00%",
            "lineageTag": "e8c38cb9-c5b2-49f1-b282-876ce821aa89"
          },
          {
            "name": "Impago Wilson Superior",
            "description": "Límite superior de Wilson (z = 1) de impago",
            "expression": "VAR n = [Num Prestamos] VAR p = DIVIDE([Prestamos con Impago] + 0, n) VAR c = DIVIDE(p + 1 / (2 * n), 1 + 1 / n) VAR m = DIVIDE(1, 1 + 1 / n) * SQRT(p * (1 - p) / n + 1 / (4 * n * n)) RETURN IF(n > 0, c + m)",
            "formatString": "0.00%",
            "lineageTag": "fc96c64c-9895-4bca-ba0f-b880a3efcd0f"
          },
          {
            "name": "Tasa Mora Banco",
            "description": "Referencia de P2: la tasa del banco, sin el filtro de distrito",
            "expression": "CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(m_distritos))",
            "formatString": "0.00%",
            "lineageTag": "6a2174a0-3aa6-4f9c-bcd7-b6a2feee6757"
          },
          {
            "name": "Tasa Impago Banco",
            "description": "Referencia de P6: impago de todas las bandas",
            "expression": "CALCULATE([Tasa Impago], REMOVEFILTERS(m_prestamos[banda_capacidad], m_prestamos[orden_banda]))",
            "formatString": "0.00%",
            "lineageTag": "e7c23a1c-fd84-4266-8e25-8e532d5b9ca8"
          },
          {
            "name": "Tasa Incumplimiento Banco",
            "description": "Referencia de P6: incumplimiento de todos los segmentos de edad",
            "expression": "CALCULATE([Tasa Incumplimiento], REMOVEFILTERS(m_clientes))",
            "formatString": "0.00%",
            "lineageTag": "f156c6cd-35d7-49e5-8ce2-de33c5e93c8b"
          },
          {
            "name": "Tasa Impago Banda Baja",
            "description": "Impago de la banda Baja (2.92%); KEEPFILTERS respeta los demás filtros",
            "expression": "CALCULATE([Tasa Impago], KEEPFILTERS(m_prestamos[banda_capacidad] = \"Baja\"))",
            "formatString": "0.00%",
            "lineageTag": "966dece3-5d5d-4e59-b6cb-ed19fbd95a0b"
          },
          {
            "name": "Tasa Impago Banda Alta",
            "description": "Impago de la banda Alta (23.26%)",
            "expression": "CALCULATE([Tasa Impago], KEEPFILTERS(m_prestamos[banda_capacidad] = \"Alta\"))",
            "formatString": "0.00%",
            "lineageTag": "1bcd6eae-a4bc-4e2d-a96c-9e62fa2663e0"
          },
          {
            "name": "Cartera Total",
            "description": "Monto original de todos los préstamos ($103,261,740)",
            "expression": "SUM(m_prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0",
            "lineageTag": "25bc73a7-a91d-44ba-8386-803663caf130"
          },
          {
            "name": "Cartera Vigente",
            "description": "Monto original C + D ($80,296,176)",
            "expression": "CALCULATE([Cartera Total], m_prestamos[codigo_estado] IN {\"C\", \"D\"})",
            "formatString": "\"$\"#,0",
            "lineageTag": "5d3cbe3f-00fa-4db5-b73d-13b2bbeeb1cb"
          },
          {
            "name": "Saldo por Cobrar Estimado",
            "description": "Capital pendiente estimado de la cartera vigente ($46,620,926)",
            "expression": "CALCULATE(SUM(m_prestamos[saldo_pendiente_estimado]), m_prestamos[codigo_estado] IN {\"C\", \"D\"})",
            "formatString": "\"$\"#,0",
            "lineageTag": "d13eb7a1-a7a6-403d-85d9-9e6b6ee3705e"
          },
          {
            "name": "Monto Original en Riesgo",
            "description": "Monto original de los préstamos B + D ($15,580,152)",
            "expression": "CALCULATE([Cartera Total], m_prestamos[codigo_estado] IN {\"B\", \"D\"})",
            "formatString": "\"$\"#,0",
            "lineageTag": "6e4e3cad-d83c-4615-9298-00455bf29480"
          },
          {
            "name": "Monto Incumplido",
            "description": "Monto original de los préstamos B",
            "expression": "CALCULATE([Cartera Total], m_prestamos[codigo_estado] = \"B\")",
            "formatString": "\"$\"#,0",
            "lineageTag": "ba4e932f-3dbc-48f0-9205-59c1469efedd"
          },
          {
            "name": "Cuota Mensual",
            "description": "Cuota mensual de los préstamos del contexto",
            "expression": "SUM(m_prestamos[pago_mensual])",
            "formatString": "\"$\"#,0",
            "lineageTag": "169f1115-17bf-4f79-aed4-b8a50635e7bd"
          },
          {
            "name": "Clientes con Impago",
            "description": "Titulares con préstamo B (31): lista de denegación",
            "expression": "CALCULATE(DISTINCTCOUNT(m_prestamos[id_cliente]), m_prestamos[codigo_estado] = \"B\")",
            "formatString": "#,0",
            "lineageTag": "a5adf418-6980-406f-9f80-0ac4c168939f"
          },
          {
            "name": "Cartera Distritos Sobre Mora Banco",
            "description": "CALCULATE + FILTER: cartera vigente de los distritos con mora sobre la del banco",
            "expression": "VAR moraBanco = CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(m_distritos)) RETURN CALCULATE([Cartera Vigente], FILTER(VALUES(m_distritos[nombre_distrito]), [Tasa Mora Vigente] > moraBanco))",
            "formatString": "\"$\"#,0",
            "lineageTag": "7aff02b9-6c45-4089-af0a-29c143d1aa56"
          },
          {
            "name": "Distritos Sobre Mora Banco",
            "description": "Distritos con tasa de mora vigente sobre la del banco",
            "expression": "VAR moraBanco = CALCULATE([Tasa Mora Vigente], REMOVEFILTERS(m_distritos)) RETURN COUNTROWS(FILTER(VALUES(m_distritos[nombre_distrito]), [Tasa Mora Vigente] > moraBanco))",
            "formatString": "#,0",
            "lineageTag": "d596de5f-97e6-4165-aaa5-ea666aaa3e75"
          },
          {
            "name": "Region Mayor Mora",
            "description": "north Moravia · 15.8%",
            "expression": "VAR r = TOPN(1, FILTER(VALUES(m_distritos[region]), [Prestamos Vigentes] > 0), [Tasa Mora Vigente], DESC) RETURN CONCATENATEX(r, m_distritos[region] & \" · \" & FORMAT([Tasa Mora Vigente], \"0.0%\"), \", \")",
            "lineageTag": "9dc093d9-8a67-41d1-8d1a-8fbd2941add9"
          },
          {
            "name": "Distrito Mayor Morosos",
            "description": "Hl.m. Praha · 4 en mora",
            "expression": "VAR d = TOPN(1, FILTER(VALUES(m_distritos[nombre_distrito]), [Prestamos en Mora] > 0), [Prestamos en Mora], DESC) RETURN CONCATENATEX(d, m_distritos[nombre_distrito] & \" · \" & [Prestamos en Mora] & \" en mora\", \", \")",
            "lineageTag": "00895a49-3f2b-49a6-bc19-b0199c6e22de"
          },
          {
            "name": "Estado Prestamo",
            "description": "Estado del préstamo del cliente o de la cuenta (fichas)",
            "expression": "IF([Num Prestamos] > 0, CALCULATE(CONCATENATEX(VALUES(m_prestamos[estado]), m_prestamos[estado], \", \"), m_prestamos))",
            "lineageTag": "3ddc37aa-811f-4428-83a2-10e21155a950"
          },
          {
            "name": "Banda Capacidad",
            "description": "Banda de capacidad de pago (ratio cuota / saldo previo)",
            "expression": "IF([Num Prestamos] > 0, CONCATENATEX(VALUES(m_prestamos[banda_capacidad]), m_prestamos[banda_capacidad], \", \"))",
            "lineageTag": "935ad268-0b31-4a7e-936a-fa03d559b28e"
          },
          {
            "name": "Distrito Prestamo",
            "description": "Distrito de la cuenta del préstamo",
            "expression": "IF([Num Prestamos] > 0, CALCULATE(CONCATENATEX(VALUES(m_distritos[nombre_distrito]), m_distritos[nombre_distrito], \", \"), m_prestamos))",
            "lineageTag": "65b56a32-1986-4229-8f5b-82019acfad5e"
          },
          {
            "name": "Banda Capacidad Impago",
            "description": "Banda del préstamo B (lista de P6)",
            "expression": "CALCULATE([Banda Capacidad], m_prestamos[codigo_estado] = \"B\")",
            "lineageTag": "b11deff6-a50f-4a06-9fe9-0177ccfb8809"
          },
          {
            "name": "Distrito Impago",
            "description": "Distrito del préstamo B (lista de P6)",
            "expression": "CALCULATE([Distrito Prestamo], m_prestamos[codigo_estado] = \"B\")",
            "lineageTag": "d6c88769-6ac5-413d-a25b-7984709b1739"
          },
          {
            "name": "Saldo Neto Corte",
            "description": "Saldo al cierre del último mes del contexto ($197,140,434 en dic-1998)",
            "expression": "VAR ultimoMes = CALCULATE(MAX(m_meses[fecha_mes]), m_saldo_mensual) RETURN CALCULATE(SUM(m_saldo_mensual[saldo_fin_mes]), FILTER(ALL(m_meses), m_meses[fecha_mes] = ultimoMes))",
            "formatString": "\"$\"#,0",
            "lineageTag": "cefaedc4-b1f7-4628-b91e-5b1e8bd96fa5"
          },
          {
            "name": "Cuentas Activas Corte",
            "description": "Cuentas con foto en el último mes del contexto (4,500 en dic-1998)",
            "expression": "VAR ultimoMes = CALCULATE(MAX(m_meses[fecha_mes]), m_saldo_mensual) RETURN CALCULATE(COUNTROWS(m_saldo_mensual), FILTER(ALL(m_meses), m_meses[fecha_mes] = ultimoMes))",
            "formatString": "#,0",
            "lineageTag": "4fa53c8f-887e-4c08-8495-967c1956275e"
          },
          {
            "name": "Cuentas en Sobregiro",
            "description": "Cuentas con saldo negativo al cierre del último mes (39 en dic-1998)",
            "expression": "VAR ultimoMes = CALCULATE(MAX(m_meses[fecha_mes]), m_saldo_mensual) RETURN CALCULATE(CALCULATE(COUNTROWS(m_saldo_mensual), m_saldo_mensual[en_sobregiro] = TRUE()), FILTER(ALL(m_meses), m_meses[fecha_mes] = ultimoMes))",
            "formatString": "#,0",
            "lineageTag": "2168e6c7-5040-40c0-9375-8f1e33cb85d5"
          },
          {
            "name": "Saldo Promedio por Cuenta",
            "description": "Saldo por cuenta activa: aísla el crecimiento por apertura de cuentas",
            "expression": "DIVIDE([Saldo Neto Corte], [Cuentas Activas Corte])",
            "formatString": "\"$\"#,0",
            "lineageTag": "19dd150b-861f-46d9-ad35-07901022d911"
          },
          {
            "name": "Saldo Promedio Banco",
            "description": "Referencia gris de D1",
            "expression": "CALCULATE([Saldo Promedio por Cuenta], REMOVEFILTERS(m_distritos))",
            "formatString": "\"$\"#,0",
            "lineageTag": "ef614694-231d-4a30-9809-439c1c73be8c"
          },
          {
            "name": "Umbral Sobregiro",
            "description": "Línea en 0 de la ficha D2",
            "expression": "IF(NOT ISBLANK([Saldo Neto Corte]), 0)",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "c6c330d2-6970-4b48-acb7-ef1f01c8fcf7"
          },
          {
            "name": "Saldo Neto Corte Total",
            "description": "Saldo al corte dic-1998, sin importar el año elegido",
            "expression": "CALCULATE([Saldo Neto Corte], REMOVEFILTERS(m_anios), REMOVEFILTERS(m_meses))",
            "formatString": "\"$\"#,0",
            "lineageTag": "42f14463-6db1-493b-8061-6f5d5df7e06b"
          },
          {
            "name": "Cartera Vigente Corte",
            "description": "Cartera vigente al corte, sin importar el año elegido",
            "expression": "CALCULATE([Cartera Vigente], REMOVEFILTERS(m_anios), REMOVEFILTERS(m_meses))",
            "formatString": "\"$\"#,0",
            "lineageTag": "5dd1afe5-af87-4381-97f8-ffc775c27a3e"
          },
          {
            "name": "Absorcion Vigente",
            "description": "KPI de liquidez de la Carta v8: cartera vigente / saldo neto al corte (40.73%)",
            "expression": "DIVIDE([Cartera Vigente Corte], [Saldo Neto Corte Total])",
            "formatString": "0.00%",
            "lineageTag": "cd81bd78-fecb-43d7-a227-8b8a1243c559"
          },
          {
            "name": "Absorcion Cartera Total",
            "description": "Referencia histórica: cartera total / saldo neto (52.38%)",
            "expression": "DIVIDE(CALCULATE([Cartera Total], REMOVEFILTERS(m_anios), REMOVEFILTERS(m_meses)), [Saldo Neto Corte Total])",
            "formatString": "0.00%",
            "lineageTag": "d79d3dbc-b6e5-4401-bfd1-f90b343fc720"
          },
          {
            "name": "Absorcion Banco",
            "description": "Referencia de P3: absorción del banco",
            "expression": "CALCULATE([Absorcion Vigente], REMOVEFILTERS(m_distritos))",
            "formatString": "0.00%",
            "lineageTag": "2dd5b517-4021-4b9c-b01e-34efcd4d322d"
          },
          {
            "name": "Liquidez Libre",
            "description": "Saldo que no respalda cartera vigente ($116,844,258)",
            "expression": "[Saldo Neto Corte Total] - [Cartera Vigente Corte]",
            "formatString": "\"$\"#,0",
            "lineageTag": "436541e0-4e4a-48d5-b098-f0719966ddd4"
          },
          {
            "name": "Valor Composicion Liquidez",
            "description": "Cascada de P3; el total es la liquidez libre",
            "expression": "SWITCH(SELECTEDVALUE(Composicion_Liquidez[concepto]), \"Saldo neto al corte\", [Saldo Neto Corte Total], \"Cartera vigente\", -[Cartera Vigente Corte])",
            "formatString": "\"$\"#,0",
            "lineageTag": "ef767489-d533-4579-969b-68eac7d0e1ca"
          },
          {
            "name": "Volumen Transaccionado",
            "description": "$6,257,862,197",
            "expression": "SUM(m_trans_anual[monto_total])",
            "formatString": "\"$\"#,0",
            "lineageTag": "1b792711-e8f8-49e2-9918-91e1244334e1"
          },
          {
            "name": "Num Transacciones",
            "description": "1,056,320",
            "expression": "SUM(m_trans_anual[num_transacciones])",
            "formatString": "#,0",
            "lineageTag": "3c03870f-de65-42f8-b529-40b36409cce7"
          },
          {
            "name": "Ticket Promedio",
            "description": "Monto promedio por movimiento",
            "expression": "DIVIDE([Volumen Transaccionado], [Num Transacciones])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "7a5ae067-8ac2-481a-ab3c-9ad3edd91021"
          },
          {
            "name": "Desv Est Transaccion",
            "description": "σ muestral exacta desde la suma y la suma de cuadrados",
            "expression": "VAR n = [Num Transacciones] VAR s = [Volumen Transaccionado] VAR sq = SUM(m_trans_anual[suma_cuadrados]) RETURN IF(n > 1, SQRT(DIVIDE(sq - s * s / n, n - 1)))",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "021ed67d-5806-4934-aa97-675878ab3bc5"
          },
          {
            "name": "Ticket Limite Superior",
            "description": "Promedio + 1σ",
            "expression": "[Ticket Promedio] + [Desv Est Transaccion]",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "e12ab31e-8363-4178-ba8b-e0f205557f95"
          },
          {
            "name": "Ticket Limite Inferior",
            "description": "Promedio − 1σ (no negativo)",
            "expression": "MAX(0, [Ticket Promedio] - [Desv Est Transaccion])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "1b549492-118a-4ee7-a4eb-2b55ea67ceda"
          },
          {
            "name": "EE Ticket",
            "description": "Error estándar (tooltip)",
            "expression": "DIVIDE([Desv Est Transaccion], SQRT([Num Transacciones]))",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "964cffae-61f1-4604-9854-374d4afe4e13"
          },
          {
            "name": "Saldo Promedio Historico",
            "description": "Saldo promedio de la cuenta ponderado por movimientos",
            "expression": "DIVIDE(SUMX(m_trans_anual, m_trans_anual[saldo_promedio] * m_trans_anual[num_transacciones]), [Num Transacciones])",
            "formatString": "\"$\"#,0",
            "lineageTag": "441b184f-cea4-4626-b938-1a263a9fd7d0"
          },
          {
            "name": "Compromiso Ordenes",
            "description": "Órdenes fijas mensuales ($21,229,041)",
            "expression": "SUM(m_ordenes[monto_orden])",
            "formatString": "\"$\"#,0",
            "lineageTag": "312a2887-7641-4898-8270-9286ced78103"
          },
          {
            "name": "Num Ordenes",
            "description": "6,471 órdenes",
            "expression": "COUNTROWS(m_ordenes)",
            "formatString": "#,0",
            "lineageTag": "995ab581-be6e-473d-a8ec-0218d069cb0a"
          },
          {
            "name": "Pct Ordenes",
            "description": "Participación de cada propósito",
            "expression": "DIVIDE([Num Ordenes], CALCULATE([Num Ordenes], REMOVEFILTERS(m_ordenes[categoria_orden])))",
            "formatString": "0.00%",
            "lineageTag": "784dc8af-3336-446a-ac1a-4d8f83a85715"
          },
          {
            "name": "Indice Saturacion",
            "description": "Órdenes mensuales / saldo promedio histórico de la cuenta (cuenta 2335: 2.14)",
            "expression": "DIVIDE([Compromiso Ordenes], CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(m_anios), REMOVEFILTERS(m_meses), REMOVEFILTERS(m_trans_anual[categoria_analitica])))",
            "formatString": "0.00",
            "lineageTag": "a03330a0-1f66-4c2a-a3c9-6a0211f3a6fb"
          },
          {
            "name": "Cuentas Saturadas",
