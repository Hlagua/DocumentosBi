          },
          {
            "name": "Estado del Prestamo",
            "dataType": "string",
            "expression": "VAR e = CALCULATE(MAX(m_prestamos[estado]), CALCULATETABLE(m_prestamos)) RETURN IF(ISBLANK(e), \"Sin préstamo\", e)",
            "lineageTag": "2fa1964a-1ed7-4a6e-8f79-54d607287d8a",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Banda de Capacidad",
            "dataType": "string",
            "expression": "VAR b = CALCULATE(MAX(m_prestamos[banda_capacidad]), CALCULATETABLE(m_prestamos)) RETURN IF(ISBLANK(b), \"Sin préstamo\", b)",
            "lineageTag": "640a0d6c-a83f-4a65-aea8-3c15ea15977b",
            "sortByColumn": "Orden Banda Cliente",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Orden Banda Cliente",
            "dataType": "int64",
            "expression": "VAR o = CALCULATE(MAX(m_prestamos[orden_banda]), CALCULATETABLE(m_prestamos)) RETURN IF(ISBLANK(o), 5, o)",
            "isHidden": true,
            "lineageTag": "93a0c58c-b8d7-4ffb-9535-c17849e3a24b",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Alerta de Saturacion",
            "dataType": "string",
            "expression": "VAR i = [Indice Saturacion] RETURN SWITCH(TRUE(), ISBLANK(i), \"Sin órdenes\", i > 1, \"Crítica (> 1)\", i > 0.5, \"Alta (> 0.5)\", \"Normal\")",
            "lineageTag": "5956308f-3e3f-4cf3-ab42-d40d28dfa44f",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Primera Oferta",
            "dataType": "string",
            "expression": "VAR x = CALCULATE(MAX(m_recomendacion_producto[producto]), m_recomendacion_producto[sistema] = \"Demográfico\", m_recomendacion_producto[posicion] = 1) RETURN IF(ISBLANK(x), \"Sin recomendación\", x)",
            "lineageTag": "a6ef13da-ec03-48cb-8a78-8c42d5bea806",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Prestamo Recomendado",
            "dataType": "string",
            "expression": "IF(CALCULATE(COUNTROWS(m_capacidad_prestamo)) = 0, \"Sin cuenta propia\", IF(CALCULATE(COUNTROWS(m_capacidad_prestamo), m_capacidad_prestamo[prestamo_recomendado] = TRUE()) > 0, \"Sí\", \"No\"))",
            "lineageTag": "41a71c19-19a3-42fb-8911-eab518d65275",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "a49430de-c774-4aab-928c-6b13b93b32ee",
        "partitions": [
          {
            "name": "m_clientes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Origen = MongoFinancial,",
                "    Tabla = Origen{[Name=\"m_clientes\"]}[Value],",
