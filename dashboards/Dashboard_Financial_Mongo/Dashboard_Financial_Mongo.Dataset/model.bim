            "expression": "CALCULATE(COUNTROWS(m_recomendacion_producto), m_recomendacion_producto[sistema] = \"Demográfico\")",
            "formatString": "#,0",
            "lineageTag": "18d59d56-4086-41e8-ac9b-175c2e19608e"
          },
          {
            "name": "Primera Opcion",
            "description": "Veces que el producto es la primera recomendación",
            "expression": "CALCULATE([Recomendaciones Demograficas], m_recomendacion_producto[posicion] = 1)",
            "formatString": "#,0",
            "lineageTag": "127edb80-d2d6-4e15-b0f5-c82d1952d02e"
          },
          {
            "name": "Recomendaciones kNN",
            "description": "Productos en el top 3 del kNN por perfil exógeno",
            "expression": "CALCULATE(COUNTROWS(m_recomendacion_producto), m_recomendacion_producto[sistema] = \"kNN perfil\")",
            "formatString": "#,0",
            "lineageTag": "57ccb0aa-460b-48e2-826e-dc1f95e16a6c"
          },
          {
            "name": "Descubrimientos kNN",
            "description": "Ofertas del kNN que el demográfico no tiene en su top 3 (2,731)",
            "expression": "CALCULATE([Recomendaciones kNN], m_recomendacion_producto[es_descubrimiento] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "a2a18ef1-8cc6-409e-85f8-a35d1e6af7e4"
          },
          {
            "name": "Clientes con Recomendacion",
            "description": "Titulares con al menos una recomendación",
            "expression": "CALCULATE(DISTINCTCOUNT(m_recomendacion_producto[id_cuenta]), m_recomendacion_producto[sistema] = \"Demográfico\")",
            "formatString": "#,0",
            "lineageTag": "7c911c99-b31b-4902-ae90-674c18729a95"
          },
          {
            "name": "Cuentas que ya lo Usan",
            "description": "Cuentas que ya usan el producto (adopción actual)",
            "expression": "COUNTROWS(m_adopcion_producto)",
            "formatString": "#,0",
            "lineageTag": "2477c564-96b9-4a45-827f-8e59bfd4657a"
          },
          {
            "name": "Titulares",
            "description": "Titulares (una cuenta cada uno: 4,500)",
            "expression": "COUNTROWS(m_capacidad_prestamo)",
            "formatString": "#,0",
            "lineageTag": "2f025a11-880b-48c8-98aa-b591469c3fbd"
          },
          {
            "name": "Penetracion Actual",
            "description": "Cuentas que ya usan el producto / titulares del contexto",
            "expression": "DIVIDE([Cuentas que ya lo Usan], [Titulares])",
            "formatString": "0.00%",
            "lineageTag": "05399f15-24a3-41e5-aac2-a7b97d3b0a59"
          },
          {
            "name": "Producto Mas Recomendado",
            "description": "Primera recomendación más frecuente en el contexto",
            "expression": "VAR x = TOPN(1, VALUES(m_dim_producto[producto]), [Primera Opcion], DESC) RETURN CONCATENATEX(x, m_dim_producto[producto] & \" · \" & FORMAT([Primera Opcion], \"#,0\"), \", \")",
            "lineageTag": "4f7ff124-c709-4480-9b43-e00721740e64"
          },
          {
            "name": "Recomendacion 1",
            "description": "Primera recomendación del titular",
            "expression": "CALCULATE(SELECTEDVALUE(m_recomendacion_producto[producto]), m_recomendacion_producto[sistema] = \"Demográfico\", m_recomendacion_producto[posicion] = 1)",
            "lineageTag": "02a5ff0f-1934-4c56-bc5d-1affb62fdf21"
          },
          {
            "name": "Recomendacion 2",
            "description": "Segunda recomendación del titular",
            "expression": "CALCULATE(SELECTEDVALUE(m_recomendacion_producto[producto]), m_recomendacion_producto[sistema] = \"Demográfico\", m_recomendacion_producto[posicion] = 2)",
            "lineageTag": "baba5f6d-e33e-4731-98de-49cfd577e014"
          },
          {
            "name": "Recomendacion 3",
            "description": "Tercera recomendación del titular",
            "expression": "CALCULATE(SELECTEDVALUE(m_recomendacion_producto[producto]), m_recomendacion_producto[sistema] = \"Demográfico\", m_recomendacion_producto[posicion] = 3)",
            "lineageTag": "b9c81d06-a48d-40b8-b930-d36e05326d1f"
          },
          {
            "name": "Descubrimiento kNN",
            "description": "Productos que el kNN añade para el titular",
            "expression": "CALCULATE(CONCATENATEX(VALUES(m_recomendacion_producto[producto]), m_recomendacion_producto[producto], \", \"), m_recomendacion_producto[sistema] = \"kNN perfil\", m_recomendacion_producto[es_descubrimiento] = TRUE())",
            "lineageTag": "9f1443ff-47ca-4df3-ba2b-b2a93e5d4ec1"
          },
          {
            "name": "Acierto Elegido",
            "description": "Hit@1 del demográfico (66.0%, semilla 42)",
            "expression": "CALCULATE(MAX(m_evaluacion_recomendador[hit_1]), m_evaluacion_recomendador[modelo] = \"Demográfico (arquetipo)\")",
            "formatString": "0.00%",
            "lineageTag": "394e5f06-670b-4183-8928-3c3760a17326"
          },
          {
            "name": "Acierto Popularidad",
            "description": "Hit@1 de recomendar lo más popular (58.5%): la línea base",
            "expression": "CALCULATE(MAX(m_evaluacion_recomendador[hit_1]), m_evaluacion_recomendador[modelo] = \"Popularidad\")",
