      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "Medidas",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Medidas",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [Medidas = text], {{\"Guía 07\"}})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cartera Total",
            "expression": "SUM(m_prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Prestamos",
            "expression": "COUNTROWS(m_prestamos)",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos en Mora",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] = \"D\")",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Vigentes",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] IN {\"C\", \"D\"})",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Incumplidos",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] = \"B\")",
            "formatString": "#,0"
          },
          {
            "name": "Prestamos Cerrados",
            "expression": "CALCULATE([Num Prestamos], m_prestamos[codigo_estado] IN {\"A\", \"B\"})",
            "formatString": "#,0"
          },
          {
            "name": "Tasa Mora Vigente",
            "expression": "DIVIDE([Prestamos en Mora], [Prestamos Vigentes])",
            "formatString": "0.00%"
          },
          {
            "name": "Tasa Incumplimiento",
            "expression": "DIVIDE([Prestamos Incumplidos], [Prestamos Cerrados])",
            "formatString": "0.00%"
          },
          {
            "name": "Monto en Riesgo",
            "expression": "CALCULATE(SUM(m_prestamos[saldo_pendiente_estimado]), m_prestamos[codigo_estado] IN {\"B\", \"D\"})",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Incumplido",
            "expression": "CALCULATE([Cartera Total], m_prestamos[codigo_estado] = \"B\")",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Monto Promedio Prestamo",
            "expression": "AVERAGE(m_prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Desv Est Prestamo",
            "expression": "STDEV.S(m_prestamos[monto_prestamo])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Prestamo Limite Superior",
            "expression": "[Monto Promedio Prestamo] + [Desv Est Prestamo]",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Prestamo Limite Inferior",
            "expression": "[Monto Promedio Prestamo] - [Desv Est Prestamo]",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "EE Prestamo",
            "expression": "DIVIDE([Desv Est Prestamo], SQRT([Num Prestamos]))",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Cuota Mensual",
            "expression": "SUM(m_prestamos[pago_mensual])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Plazo Meses",
            "expression": "MAX(m_prestamos[plazo_meses])",
            "formatString": "#,0"
          },
          {
            "name": "Saldo Pendiente",
            "expression": "SUM(m_prestamos[saldo_pendiente_estimado])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Distritos con Prestamos",
            "expression": "DISTINCTCOUNT(m_prestamos[id_distrito])",
            "formatString": "#,0"
          },
          {
            "name": "Clientes con Impago",
            "expression": "CALCULATE(DISTINCTCOUNT(m_prestamos[id_cliente]), m_prestamos[codigo_estado] = \"B\")",
            "formatString": "#,0"
          },
          {
            "name": "Saldo Depositos",
            "expression": "SUM(m_saldo_cuenta[saldo_final])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Ratio Absorcion",
            "expression": "DIVIDE(CALCULATE([Cartera Total], REMOVEFILTERS(m_anios)), [Saldo Depositos])",
            "formatString": "0.00%"
          },
          {
            "name": "Liquidez Libre",
            "expression": "[Saldo Depositos] - CALCULATE([Cartera Total], REMOVEFILTERS(m_anios))",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Volumen Transaccionado",
            "expression": "SUM(m_trans_anual[monto_total])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Transacciones",
            "expression": "SUM(m_trans_anual[num_transacciones])",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Promedio Transaccion",
            "expression": "DIVIDE([Volumen Transaccionado], [Num Transacciones])",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Desv Est Transaccion",
            "expression": "VAR n = [Num Transacciones] VAR s = [Volumen Transaccionado] VAR sq = SUM(m_trans_anual[suma_cuadrados]) RETURN SQRT(DIVIDE(sq - s * s / n, n - 1))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Transaccion Limite Superior",
            "expression": "[Ticket Promedio Transaccion] + [Desv Est Transaccion]",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Transaccion Limite Inferior",
            "expression": "[Ticket Promedio Transaccion] - [Desv Est Transaccion]",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "EE Transaccion",
            "expression": "DIVIDE([Desv Est Transaccion], SQRT([Num Transacciones]))",
            "formatString": "\"$\"#,0.00"
          },
          {
            "name": "Saldo Promedio Historico",
            "expression": "DIVIDE(SUMX(m_trans_anual, m_trans_anual[saldo_promedio] * m_trans_anual[num_transacciones]), [Num Transacciones])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Compromiso Ordenes",
            "expression": "SUM(m_ordenes[monto_orden])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Num Ordenes",
            "expression": "COUNTROWS(m_ordenes)",
            "formatString": "#,0"
          },
          {
            "name": "Indice Saturacion",
            "expression": "DIVIDE([Compromiso Ordenes], CALCULATE([Saldo Promedio Historico], REMOVEFILTERS(m_anios), REMOVEFILTERS(m_trans_anual[tipo_operacion])))",
            "formatString": "0.00"
          },
          {
            "name": "Indice Saturacion Alerta",
            "expression": "VAR i = [Indice Saturacion] RETURN IF(i > 0.5, i)",
            "formatString": "0.00"
          },
          {
            "name": "Compromiso Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Compromiso Ordenes])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Saldo Promedio Alerta",
            "expression": "IF([Indice Saturacion] > 0.5, [Saldo Promedio Historico])",
            "formatString": "\"$\"#,0"
          },
          {
            "name": "Clientes Saturados",
            "expression": "COUNTROWS(FILTER(VALUES(m_clientes[id_cliente]), [Indice Saturacion] > 0.5))",
            "formatString": "#,0"
          },
          {
            "name": "Clientes Totales",
            "expression": "COUNTROWS(m_clientes)",
            "formatString": "#,0"
          },
          {
            "name": "EE Mora",
            "expression": "SQRT(DIVIDE([Tasa Mora Vigente] * (1 - [Tasa Mora Vigente]), [Prestamos Vigentes]))",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Limite Superior",
            "expression": "[Tasa Mora Vigente] + [EE Mora]",
            "formatString": "0.00%"
          },
          {
            "name": "Mora Limite Inferior",
            "expression": "MAX(0, [Tasa Mora Vigente] - [EE Mora])",
            "formatString": "0.00%"
          },
          {
            "name": "EE Incumplimiento",
            "expression": "SQRT(DIVIDE([Tasa Incumplimiento] * (1 - [Tasa Incumplimiento]), [Prestamos Cerrados]))",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Limite Superior",
            "expression": "[Tasa Incumplimiento] + [EE Incumplimiento]",
            "formatString": "0.00%"
          },
          {
            "name": "Incumplimiento Limite Inferior",
            "expression": "MAX(0, [Tasa Incumplimiento] - [EE Incumplimiento])",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Ordenes",
            "expression": "DIVIDE([Num Ordenes], CALCULATE([Num Ordenes], REMOVEFILTERS(m_ordenes[categoria_orden])))",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Volumen",
            "expression": "DIVIDE([Volumen Transaccionado], CALCULATE([Volumen Transaccionado], REMOVEFILTERS(m_trans_anual[tipo_operacion])))",
            "formatString": "0.00%"
          },
          {
            "name": "Pct Cartera",
            "expression": "DIVIDE([Cartera Total], CALCULATE([Cartera Total], REMOVEFILTERS(m_distritos)))",
            "formatString": "0.00%"
          },
          {
            "name": "Region Mayor Mora",
            "expression": "VAR t = TOPN(1, VALUES(m_distritos[region]), [Tasa Mora Vigente], DESC) RETURN MAXX(t, m_distritos[region]) & \" · \" & FORMAT(MAXX(t, [Tasa Mora Vigente]), \"0.00%\")"
          },
          {
            "name": "Region Mayor Cartera",
            "expression": "VAR t = TOPN(1, VALUES(m_distritos[region]), [Cartera Total], DESC) RETURN MAXX(t, m_distritos[region]) & \" · \" & FORMAT(MAXX(t, [Pct Cartera]), \"0.0%\")"
          },
          {
            "name": "Region Mayor Absorcion",
            "expression": "VAR t = TOPN(1, VALUES(m_distritos[region]), [Ratio Absorcion], DESC) RETURN MAXX(t, m_distritos[region]) & \" · \" & FORMAT(MAXX(t, [Ratio Absorcion]), \"0.00%\")"
          },
          {
            "name": "Operacion Mayor Volumen",
            "expression": "VAR t = TOPN(1, VALUES(m_trans_anual[tipo_operacion]), [Volumen Transaccionado], DESC) RETURN MAXX(t, m_trans_anual[tipo_operacion]) & \" · \" & FORMAT(MAXX(t, [Pct Volumen]), \"0.00%\")"
          },
          {
            "name": "Categoria Principal Orden",
            "expression": "VAR t = TOPN(1, VALUES(m_ordenes[categoria_orden]), [Num Ordenes], DESC) RETURN MAXX(t, m_ordenes[categoria_orden]) & \" · \" & FORMAT(MAXX(t, [Pct Ordenes]), \"0.00%\")"
          },
          {
            "name": "Titulo Distrito",
            "expression": "\"Detalle del distrito: \" & SELECTEDVALUE(m_distritos[nombre_distrito], \"(varios)\")"
          },
          {
            "name": "Titulo Cliente",
            "expression": "\"Ficha 360 · \" & SELECTEDVALUE(m_clientes[cliente], \"(varios clientes)\")"
          }
        ]
      }
    ],
    "relationships": [
      {
