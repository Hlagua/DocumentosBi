          }
        ],
        "partitions": [
          {
            "name": "m_distritos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = MongoFinancial,",
                "    Tabla = Origen{[Name=\"m_distritos\"]}[Value],",
                "    Columnas = Table.SelectColumns(Tabla, {\"id_distrito\", \"nombre_distrito\", \"region\", \"poblacion\", \"salario_promedio\", \"tasa_desempleo\", \"tasa_criminalidad\", \"macro_region\"}),",
                "    Tipos = Table.TransformColumnTypes(Columnas, {{\"id_distrito\", Int64.Type}, {\"nombre_distrito\", type text}, {\"region\", type text}, {\"poblacion\", Int64.Type}, {\"salario_promedio\", type number}, {\"tasa_desempleo\", type number}, {\"tasa_criminalidad\", type number}, {\"macro_region\", type text}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
