    ],
    "expressions": [
      {
        "name": "MongoFinancial",
        "kind": "m",
        "expression": [
          "let",
          "    Origen = Python.Execute(\"\"\"\"\"\"\"#(lf)==============================================================================#(lf)UNIVERSIDAD TÉCNICA DE AMBATO - Inteligencia de Negocios#(lf)AUTORES: Alison Marcela Cobos Taco / Henry Daniel Lagua Flores#(lf)==============================================================================#(lf)ARCHIVO: 26_powerbi_mongo_dashboard.py#(lf)USO EN POWER BI: Obtener datos -> Más... -> Script de Python -> pegar TODO#(lf)                 este archivo -> Aceptar -> marcar las 7 tablas m_*.#(lf)#(lf)Construye el modelo estrella del Dashboard_Financial_Mongo.pbix a partir de#(lf)la base documental 'Financial' (MongoDB). Las transacciones y el saldo final#(lf)se calculan DENTRO de MongoDB con Aggregation Pipelines ($group), de modo que#(lf)Power BI recibe ~54 mil filas en lugar de 1,056,320.#(lf)#(lf)Funciona con los dos esquemas de carga del proyecto:#(lf)  * Esquema documental anidado (script 22 / Financial_mongo_dump.gz)#(lf)  * Esquema plano (script 23, restauración desde CSV)#(lf)#(lf)Tablas resultantes (mismas claves y nombres de columnas que el modelo Kimball#(lf)para reutilizar las medidas DAX de la guía 07):#(lf)  m_distritos        77 filas     (dimensión)#(lf)  m_clientes      5,369 filas     (dimensión, Cliente 360)#(lf)  m_anios             6 filas     (dimensión de tiempo anual 1993-1998)#(lf)  m_prestamos       682 filas     (hecho)#(lf)  m_ordenes       6,471 filas     (hecho)#(lf)  m_trans_anual  ~54,298 filas    (hecho agregado cuenta-año-operación)#(lf)  m_saldo_cuenta  4,500 filas     (hecho semiaditivo: último saldo)#(lf)==============================================================================#(lf)\"\"\"\"\"\"#(lf)import pandas as pd#(lf)import pymongo#(lf)#(lf)MONGO_URI = \"\"mongodb://localhost:27017/\"\"#(lf)DB_NAME = \"\"Financial\"\"#(lf)#(lf)client = pymongo.MongoClient(MONGO_URI)#(lf)db = client[DB_NAME]#(lf)#(lf)#(lf)def campo(doc, *rutas, defecto=None):#(lf)    \"\"\"\"\"\"Devuelve el primer valor existente entre varias rutas 'a.b.c'.\"\"\"\"\"\"#(lf)    for ruta in rutas:#(lf)        valor = doc#(lf)        for parte in ruta.split(\"\".\"\"):#(lf)            if isinstance(valor, dict) and parte in valor:#(lf)                valor = valor[parte]#(lf)            else:#(lf)                valor = None#(lf)                break#(lf)        if valor is not None and not (isinstance(valor, float) and pd.isna(valor)):#(lf)            return valor#(lf)    return defecto#(lf)#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 1. DIMENSIÓN DISTRITO#(lf)# ------------------------------------------------------------------------------#(lf)m_distritos = pd.DataFrame([{#(lf)    \"\"id_distrito\"\": int(campo(d, \"\"id_distrito\"\", \"\"_id\"\")),#(lf)    \"\"nombre_distrito\"\": campo(d, \"\"nombre\"\", \"\"nombre_distrito\"\"),#(lf)    \"\"region\"\": campo(d, \"\"region\"\"),#(lf)    \"\"poblacion\"\": campo(d, \"\"poblacion\"\"),#(lf)    \"\"salario_promedio\"\": campo(d, \"\"salario_promedio\"\"),#(lf)    \"\"tasa_desempleo\"\": campo(d, \"\"tasa_desempleo\"\"),#(lf)    \"\"tasa_criminalidad\"\": campo(d, \"\"tasa_criminalidad\"\"),#(lf)    \"\"es_imputado\"\": bool(campo(d, \"\"auditoria.es_imputado\"\", \"\"es_imputado\"\", defecto=False)),#(lf)} for d in db.distritos.find({})])#(lf)#(lf)MACRO = {\"\"Prague\"\": \"\"Praga\"\"}#(lf)m_distritos[\"\"macro_region\"\"] = m_distritos[\"\"region\"\"].map(#(lf)    lambda r: MACRO.get(r, \"\"Moravia\"\" if \"\"Moravia\"\" in str(r) else \"\"Bohemia\"\"))#(lf)region_de = m_distritos.set_index(\"\"id_distrito\"\")[\"\"region\"\"].to_dict()#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 2. DIMENSIÓN CLIENTE 360 (colección FinancialMongo)#(lf)# ------------------------------------------------------------------------------#(lf)m_clientes = pd.DataFrame([{#(lf)    \"\"id_cliente\"\": int(campo(c, \"\"id_cliente\"\", \"\"_id\"\")),#(lf)    \"\"sexo\"\": campo(c, \"\"datos_personales.sexo\"\", \"\"sexo\"\"),#(lf)    \"\"edad_corte\"\": campo(c, \"\"datos_personales.edad_al_corte_1998\"\", \"\"edad_corte\"\"),#(lf)    \"\"tipo_disposicion\"\": campo(c, \"\"datos_personales.tipo_disposicion\"\", \"\"tipo_disposicion\"\"),#(lf)    \"\"calificacion_pago\"\": str(campo(c, \"\"evaluacion_crediticia.calificacion\"\",#(lf)                                   \"\"etiqueta_buen_pagador\"\", defecto=\"\"Sin evaluar\"\")),#(lf)    \"\"tiene_prestamo\"\": bool(campo(c, \"\"evaluacion_crediticia.tiene_prestamo\"\",#(lf)                                 \"\"tiene_prestamo\"\", defecto=False)),#(lf)    \"\"id_distrito_residencia\"\": campo(c, \"\"distrito.id_distrito\"\", \"\"id_distrito\"\"),#(lf)    \"\"total_ordenes_activas\"\": campo(c, \"\"perfil_analitico.total_ordenes_activas\"\",#(lf)                                   \"\"total_ordenes_activas\"\", defecto=0),#(lf)} for c in db.FinancialMongo.find({}, {\"\"ordenes_recurrentes\"\": 0, \"\"prestamo_asociado\"\": 0})])#(lf)#(lf)m_clientes[\"\"calificacion_pago\"\"] = m_clientes[\"\"calificacion_pago\"\"].replace(#(lf)    {\"\"True\"\": \"\"Buen pagador\"\", \"\"False\"\": \"\"Moroso historico\"\", \"\"1\"\": \"\"Buen pagador\"\", \"\"0\"\": \"\"Moroso historico\"\"})#(lf)m_clientes[\"\"cliente\"\"] = \"\"Cliente \"\" + m_clientes[\"\"id_cliente\"\"].astype(str)#(lf)m_clientes[\"\"segmento_edad\"\"] = pd.cut(#(lf)    m_clientes[\"\"edad_corte\"\"], bins=[0, 25, 40, 60, 200],#(lf)    labels=[\"\"Joven (<=25)\"\", \"\"Adulto joven (26-40)\"\", \"\"Adulto (41-60)\"\", \"\"Mayor (>60)\"\"]#(lf)).astype(str)#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 3. HECHO PRÉSTAMOS#(lf)# ------------------------------------------------------------------------------#(lf)m_prestamos = pd.DataFrame([{#(lf)    \"\"id_prestamo\"\": int(campo(p, \"\"id_prestamo\"\", \"\"_id\"\")),#(lf)    \"\"id_cuenta\"\": int(campo(p, \"\"id_cuenta\"\")),#(lf)    \"\"id_cliente\"\": int(campo(p, \"\"id_cliente\"\")),#(lf)    \"\"id_distrito\"\": int(campo(p, \"\"distrito.id_distrito\"\", \"\"id_distrito\"\")),#(lf)    \"\"fecha_otorgamiento\"\": campo(p, \"\"condiciones.fecha_otorgamiento\"\", \"\"fecha_otorgamiento\"\"),#(lf)    \"\"monto_prestamo\"\": float(campo(p, \"\"condiciones.monto\"\", \"\"monto_prestamo\"\")),#(lf)    \"\"plazo_meses\"\": int(campo(p, \"\"condiciones.plazo_meses\"\", \"\"plazo_meses\"\")),#(lf)    \"\"pago_mensual\"\": float(campo(p, \"\"condiciones.cuota_mensual\"\", \"\"pago_mensual\"\")),#(lf)    \"\"saldo_pendiente_estimado\"\": float(campo(p, \"\"condiciones.saldo_pendiente\"\",#(lf)                                            \"\"saldo_pendiente_estimado\"\", defecto=0)),#(lf)    \"\"codigo_estado\"\": campo(p, \"\"evaluacion_riesgo.codigo_estado\"\", \"\"estado_prestamo\"\"),#(lf)    \"\"condicion\"\": campo(p, \"\"evaluacion_riesgo.condicion\"\", \"\"condicion_prestamo\"\"),#(lf)    \"\"descripcion_estado\"\": campo(p, \"\"evaluacion_riesgo.descripcion\"\", \"\"descripcion_estado\"\"),#(lf)} for p in db.prestamos.find({})])#(lf)#(lf)m_prestamos[\"\"fecha_otorgamiento\"\"] = pd.to_datetime(m_prestamos[\"\"fecha_otorgamiento\"\"])#(lf)m_prestamos[\"\"anio\"\"] = m_prestamos[\"\"fecha_otorgamiento\"\"].dt.year#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 4. HECHO ÓRDENES PERMANENTES#(lf)# ------------------------------------------------------------------------------#(lf)m_ordenes = pd.DataFrame([{#(lf)    \"\"id_orden\"\": int(campo(o, \"\"id_orden\"\", \"\"_id\"\")),#(lf)    \"\"id_cuenta\"\": int(campo(o, \"\"id_cuenta\"\")),#(lf)    \"\"id_cliente\"\": int(campo(o, \"\"id_cliente\"\")),#(lf)    \"\"id_distrito\"\": campo(o, \"\"id_distrito\"\"),#(lf)    \"\"k_symbol\"\": campo(o, \"\"categoria_pago.codigo\"\", \"\"k_symbol\"\"),#(lf)    \"\"categoria_orden\"\": campo(o, \"\"categoria_pago.descripcion\"\", \"\"categoria_orden\"\"),#(lf)    \"\"monto_orden\"\": float(campo(o, \"\"monto_mensual\"\", \"\"monto_orden\"\")),#(lf)} for o in db.ordenes.find({})])#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 5. HECHOS DE TRANSACCIONES (agregados en MongoDB)#(lf)# ------------------------------------------------------------------------------#(lf)pipeline_anual = [#(lf)    {\"\"$group\"\": {#(lf)        \"\"_id\"\": {\"\"id_cuenta\"\": \"\"$id_cuenta\"\", \"\"anio\"\": \"\"$anio\"\",#(lf)                \"\"tipo_operacion\"\": \"\"$tipo_operacion_traducido\"\"},#(lf)        \"\"id_cliente\"\": {\"\"$first\"\": \"\"$id_cliente\"\"},#(lf)        \"\"id_distrito\"\": {\"\"$first\"\": \"\"$id_distrito\"\"},#(lf)        \"\"canal\"\": {\"\"$first\"\": \"\"$canal\"\"},#(lf)        \"\"num_transacciones\"\": {\"\"$sum\"\": 1},#(lf)        \"\"monto_total\"\": {\"\"$sum\"\": \"\"$monto_transaccion\"\"},#(lf)        \"\"suma_cuadrados\"\": {\"\"$sum\"\": {\"\"$multiply\"\": [\"\"$monto_transaccion\"\", \"\"$monto_transaccion\"\"]}},#(lf)        \"\"saldo_promedio\"\": {\"\"$avg\"\": \"\"$saldo_cuenta\"\"},#(lf)    }},#(lf)]#(lf)m_trans_anual = pd.json_normalize(#(lf)    list(db.transacciones.aggregate(pipeline_anual, allowDiskUse=True)))#(lf)m_trans_anual.columns = [c.replace(\"\"_id.\"\", \"\"\"\") for c in m_trans_anual.columns]#(lf)#(lf)pipeline_saldo = [#(lf)    {\"\"$sort\"\": {\"\"id_cuenta\"\": 1, \"\"fecha\"\": -1, \"\"_id\"\": -1}},#(lf)    {\"\"$group\"\": {#(lf)        \"\"_id\"\": \"\"$id_cuenta\"\",#(lf)        \"\"id_cliente\"\": {\"\"$first\"\": \"\"$id_cliente\"\"},#(lf)        \"\"id_distrito\"\": {\"\"$first\"\": \"\"$id_distrito\"\"},#(lf)        \"\"fecha_ultimo_movimiento\"\": {\"\"$first\"\": \"\"$fecha\"\"},#(lf)        \"\"saldo_final\"\": {\"\"$first\"\": \"\"$saldo_cuenta\"\"},#(lf)    }},#(lf)]#(lf)m_saldo_cuenta = pd.DataFrame(#(lf)    list(db.transacciones.aggregate(pipeline_saldo, allowDiskUse=True))#(lf)).rename(columns={\"\"_id\"\": \"\"id_cuenta\"\"})#(lf)m_saldo_cuenta[\"\"fecha_ultimo_movimiento\"\"] = pd.to_datetime(m_saldo_cuenta[\"\"fecha_ultimo_movimiento\"\"])#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 6. DISTRITO DE LA CUENTA en cada hecho (si el documento no lo trae, se hereda#(lf)#    de la cuenta a través de préstamos/órdenes o, en último caso, del cliente).#(lf)#    Igual que en Kimball: el distrito del hecho es el de la CUENTA.#(lf)# ------------------------------------------------------------------------------#(lf)distrito_cuenta = (#(lf)    pd.concat([m_prestamos[[\"\"id_cuenta\"\", \"\"id_distrito\"\"]],#(lf)               m_ordenes[[\"\"id_cuenta\"\", \"\"id_distrito\"\"]],#(lf)               m_trans_anual[[\"\"id_cuenta\"\", \"\"id_distrito\"\"]] if \"\"id_distrito\"\" in m_trans_anual else None])#(lf)    .dropna().drop_duplicates(\"\"id_cuenta\"\").set_index(\"\"id_cuenta\"\")[\"\"id_distrito\"\"]#(lf))#(lf)distrito_cliente = m_clientes.set_index(\"\"id_cliente\"\")[\"\"id_distrito_residencia\"\"]#(lf)for df in (m_ordenes, m_trans_anual, m_saldo_cuenta):#(lf)    if \"\"id_distrito\"\" not in df:#(lf)        df[\"\"id_distrito\"\"] = None#(lf)    df[\"\"id_distrito\"\"] = (df[\"\"id_distrito\"\"]#(lf)                         .fillna(df[\"\"id_cuenta\"\"].map(distrito_cuenta))#(lf)                         .fillna(df[\"\"id_cliente\"\"].map(distrito_cliente))#(lf)                         .astype(int))#(lf)#(lf)# ------------------------------------------------------------------------------#(lf)# 7. DIMENSIÓN AÑO#(lf)# ------------------------------------------------------------------------------#(lf)m_anios = pd.DataFrame({\"\"anio\"\": range(1993, 1999)})#(lf)#(lf)# El puente Python de Power BI no reconoce el tipo StringDtype de pandas >= 3.#(lf)for df in (m_distritos, m_clientes, m_prestamos, m_ordenes, m_trans_anual, m_saldo_cuenta):#(lf)    for col in df.columns:#(lf)        if pd.api.types.is_string_dtype(df[col]) and not pd.api.types.is_object_dtype(df[col]):#(lf)            df[col] = df[col].astype(object)#(lf)#(lf)client.close()#(lf)#(lf)print(\"\"Tablas MongoDB listas para Power BI:\"\")#(lf)for nombre in [\"\"m_distritos\"\", \"\"m_clientes\"\", \"\"m_anios\"\", \"\"m_prestamos\"\",#(lf)               \"\"m_ordenes\"\", \"\"m_trans_anual\"\", \"\"m_saldo_cuenta\"\"]:#(lf)    print(f\"\"  - {nombre:<15} {len(globals()[nombre]):>8,} filas\"\")#(lf)\")",
          "in",
          "    Origen"
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}