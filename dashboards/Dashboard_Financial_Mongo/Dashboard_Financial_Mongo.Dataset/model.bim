          },
          {
            "name": "AUC Regla Elegida",
            "description": "0.717",
            "expression": "CALCULATE([AUC Regla], m_regla_capacidad[regla] = \"Carta v8: cuota / saldo previo\")",
            "formatString": "0.000",
            "lineageTag": "f8ec12b4-f3ac-4f05-8c24-aa5d48f62820"
          },
          {
            "name": "AUC Regla Anterior",
            "description": "0.659",
            "expression": "CALCULATE([AUC Regla], m_regla_capacidad[regla] = \"Anterior: cuota / salario del distrito\")",
            "formatString": "0.000",
            "lineageTag": "3e9d86f3-a5bf-4e60-973a-848b70cf8e06"
          },
          {
            "name": "P Destino dado Origen",
            "description": "De quienes tienen el producto de origen, % que también tiene el de destino",
            "expression": "SUM(m_asociacion_producto[p_destino_dado_origen])",
            "formatString": "0.00%",
            "lineageTag": "0bbaa8f9-0ccb-4730-8382-4805a287860f"
          },
          {
            "name": "Lift Asociacion",
            "description": "Lift: > 1 van juntos más de lo esperado por azar",
            "expression": "SUM(m_asociacion_producto[lift])",
            "formatString": "0.00",
            "lineageTag": "7e5d6698-97c0-43c2-8971-b4862daf39ca"
          },
          {
            "name": "Regla Mas Fuerte",
            "description": "Par con mayor lift (al menos 100 cuentas), en la dirección de mayor P(j|i): Seguro → Transferencias 99.8%",
            "expression": "VAR x = TOPN(1, FILTER(m_asociacion_producto, m_asociacion_producto[cuentas_ambos] >= 100), m_asociacion_producto[lift], DESC, m_asociacion_producto[p_destino_dado_origen], DESC) RETURN CONCATENATEX(x, m_asociacion_producto[producto_origen] & \" → \" & m_asociacion_producto[producto_destino] & \" · \" & FORMAT(m_asociacion_producto[p_destino_dado_origen], \"0.0%\"), \", \")",
            "lineageTag": "7c004287-8ff9-4070-a524-f64e23dc898a"
          },
          {
            "name": "Color Mora",
            "description": "Treemap de P2: escala secuencial blanco → bermellón por tasa de mora",
            "expression": "VAR x = [Tasa Mora Vigente] RETURN SWITCH(TRUE(), ISBLANK(x), \"#FFFFFF\", x < 0.05, \"#FBE3D3\", x < 0.10, \"#F2B48C\", x < 0.15, \"#E5813F\", \"#D55E00\")",
            "lineageTag": "d7fb11c6-3906-42e1-b388-8d0431b0dc3a"
          },
          {
            "name": "Color Saturacion",
            "description": "Dispersión de P5: bermellón > 1, naranja > 0.5, gris el resto",
            "expression": "VAR x = [Indice Saturacion] RETURN IF(x > 1, \"#D55E00\", IF(x > 0.5, \"#E69F00\", \"#7F7F7F\"))",
            "lineageTag": "f0f5ab34-eb81-4d03-82c3-7d7317b26544"
          },
          {
            "name": "Color Modelo",
            "description": "R1: modelos elegidos en azul, el resto en gris",
            "expression": "IF(SELECTEDVALUE(m_evaluacion_recomendador[elegido]) = TRUE(), \"#0072B2\", \"#BDBDBD\")",
            "lineageTag": "801035a1-802c-49c8-9768-d29953307bfe"
          },
          {
            "name": "Color Regla",
            "description": "R2: regla elegida en azul",
            "expression": "IF(SELECTEDVALUE(m_regla_capacidad[regla]) = \"Carta v8: cuota / saldo previo\", \"#0072B2\", \"#BDBDBD\")",
            "lineageTag": "a18b7059-c5e7-43d5-885a-7537ec5d6478"
          }
